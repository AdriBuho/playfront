<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.SettingsView"
             Width="1920" Height="1080">
    <!-- Pantalla de Ajustes (1:1 con la General de Xbox). EXTRAIDA de MainWindow a su propia vista
         para cargarse BAJO DEMANDA (arquitectura de rendimiento: nada se construye antes de abrirse):
         la ventana solo monta la Home al arrancar; esta vista se crea al entrar en Ajustes
         (MainWindow.EnterSettings) y se libera al salir (ExitSettings), para no tenerla residente.
         Los estilos (Border.settingsNavItem / settingsCard / selectionRing) y los recursos de tema
         (AccentBrush, SettingsHighlightShadow) viven en la ventana/app y CASCADEAN hasta aqui, asi que
         no se duplican. La logica de navegacion esta en el code-behind (SettingsView.axaml.cs); lo que
         SALE de esta pantalla (abrir Personalization, salir a la home) se avisa por eventos. -->
    <Canvas Width="1920" Height="1080">
        <Rectangle Width="1920" Height="1080" Fill="#201F1F" />
        <Rectangle Canvas.Left="478" Canvas.Top="0" Width="1" Height="1080" Fill="#3A3A3A" />

        <!-- Cabecera: engranaje + avatar + nombre de usuario, en un StackPanel
             horizontal para que los 3 queden centrados verticalmente entre si sin
             calcular cada Canvas.Top a mano (cada uno tiene una altura distinta). El
             borde izquierdo del StackPanel (Canvas.Left=100) coincide a proposito con
             el borde izquierdo del texto de la lista de categorias de abajo (mismo
             Margin=100 de Border.settingsNavItem TextBlock) - medido pixel a pixel
             contra la referencia real, donde tambien coinciden. -->
        <StackPanel Canvas.Left="100" Canvas.Top="52" Orientation="Horizontal" Spacing="18">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="28" Foreground="White" VerticalAlignment="Center" />
            <Border Width="34" Height="34" CornerRadius="17" ClipToBounds="True" VerticalAlignment="Center">
                <Image Source="/Assets/Icons/avatar.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="SettingsUserNameText" Foreground="White" FontSize="20" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Lista de categorias -->

        <!-- Resalte compartido de la categoria seleccionada: un unico rectangulo verde
             que se DESPLAZA (RenderTransform translateY, animado) entre categorias en
             vez de que cada Border.settingsNavItem encienda/apague su propio fondo
             verde de golpe - eso se veia como un parpadeo (aparece en una, desaparece
             en otra) en vez de un movimiento fluido, igual que en Xbox real. Colocado
             ANTES que las SNavX en el XAML (o sea, detras en z-order) para que el texto
             de cada categoria quede siempre legible encima. Su Canvas.Top de base
             coincide con la posicion de SNav1 ("General", categoria por defecto al
             abrir Ajustes) - el code-behind (UpdateSelection) mueve el resto
             via translateY relativo a esa base, y lo oculta del todo mientras el foco
             esta dentro de la rejilla de tarjetas. -->
        <Border x:Name="SettingsNavHighlight" Canvas.Left="0" Canvas.Top="216" Width="478" Height="62"
                CornerRadius="4" Background="{DynamicResource AccentBrush}" BoxShadow="{DynamicResource SettingsHighlightShadow}">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseInOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- Indicador de "categoria abierta" (referencia: sel.png en el escritorio del
             usuario) - toma el relevo de SettingsNavHighlight en cuanto el foco entra en
             la rejilla de tarjetas: ya no tiene sentido el bloque verde solido (eso es
             para navegar la lista), pero el usuario sigue necesitando saber en que
             categoria esta mientras mueve las tarjetas. Franja gris tenue de fondo
             (mismo tono que Border.settingsCard) + una barrita fina verde pegada al
             borde derecho, junto a la linea divisoria de la barra lateral (Canvas.Left
             478 en el XAML). Comparte el mismo mecanismo de desplazamiento por
             translateY que SettingsNavHighlight (mismo Canvas.Top base, 216=fila de
             "General"), asi que ambos usan el mismo offset en el code-behind. -->
        <Border x:Name="SettingsCategoryIndicator" Canvas.Left="0" Canvas.Top="216" Width="478" Height="62"
                Background="#303030" IsVisible="False">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseInOut" />
                </Transitions>
            </Border.Transitions>
            <Rectangle Width="4" Height="62" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
        </Border>

        <Border Classes="settingsNavItem" x:Name="SNav0" Canvas.Left="0" Canvas.Top="153"><TextBlock Text="Recommendations" /></Border>
        <!-- Divisor pegado al borde superior de la casilla de "General" (Canvas.Top=216):
             la linea ocupa la fila 215, asi que la casilla arranca justo donde termina. -->
        <Rectangle Canvas.Left="35" Canvas.Top="215" Width="410" Height="1" Fill="#3A3A3A" />
        <Border Classes="settingsNavItem" x:Name="SNav1" Canvas.Left="0" Canvas.Top="216"><TextBlock Text="General" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav2" Canvas.Left="0" Canvas.Top="280"><TextBlock Text="Account" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav3" Canvas.Left="0" Canvas.Top="344"><TextBlock Text="System" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav4" Canvas.Left="0" Canvas.Top="408"><TextBlock Text="Devices &amp; connections" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav5" Canvas.Left="0" Canvas.Top="472"><TextBlock Text="Preferences" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav6" Canvas.Left="0" Canvas.Top="536"><TextBlock Text="Accessibility" /></Border>

        <!-- Contenido de "General": titulo + rejilla 2x3 de tarjetas -->
        <TextBlock x:Name="SettingsCategoryTitle" Canvas.Left="528" Canvas.Top="160" Text="General"
                   Foreground="White" FontSize="40" FontWeight="Bold" />

        <!-- Fila 1 -->
        <Border Classes="settingsCard selected" x:Name="SCard0" Canvas.Left="567" Canvas.Top="256" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <!-- Icono real de sistema, no aproximado: no existe como archivo suelto
                     en la app de Xbox instalada (se busco a fondo en su carpeta de
                     iconos), pero SI existe como un unico glifo
                     ya hecho de wifi+engranaje en la fuente de iconos de Windows 11
                     "Segoe Fluent Icons" (codigo F080) - el mismo dibujo, encontrado
                     barriendo visualmente cientos de glifos de la fuente hasta dar con
                     el exacto. Antes era una composicion de 2 iconos por separado. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xF080;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Network settings" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SCard1" Canvas.Left="1026" Canvas.Top="256" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Personalization" />
            </StackPanel>
        </Border>

        <!-- Fila 2 -->
        <Border Classes="settingsCard" x:Name="SCard2" Canvas.Left="567" Canvas.Top="402" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <Viewbox Width="36" Height="36">
                    <Canvas Width="32" Height="32">
                        <!-- El dibujo exacto de la referencia (dos cables/conectores) no
                             existe suelto en ningun sitio al que tengamos acceso (ni en
                             los SVG propios de la app de Xbox, ni en la fuente de iconos
                             de Windows, donde se buscaron mas de 4000 glifos),
                             y dos intentos de calcarlo a mano no
                             salieron lo bastante claros a este tamaño. A peticion del
                             usuario, sustituido por "PC1.svg" - un icono real (no
                             aproximado) de dispositivos/pantalla que si esta en el set
                             propio de la app de Xbox instalada, aunque no sea el dibujo
                             exacto de la referencia. -->
                        <Path Fill="White"
                              Data="M4,30 C3.59,30 3.21,29.92 2.84,29.77 C2.48,29.61 2.16,29.4 1.89,29.13 C1.62,28.86 1.4,28.53 1.24,28.16 C1.07,27.78 0.99,27.4 1,27 L1,5 C1,4.59 1.08,4.21 1.24,3.84 C1.39,3.48 1.61,3.16 1.88,2.89 C2.15,2.62 2.47,2.4 2.84,2.24 C3.22,2.07 3.61,1.99 4,2 L14,2 C14.41,2 14.79,2.08 15.16,2.24 C15.52,2.39 15.84,2.61 16.11,2.88 C16.38,3.15 16.6,3.47 16.77,3.84 C16.93,4.22 17.01,4.61 17,5 L17,8 L15,8 L15,5 C15,4.73 14.9,4.5 14.7,4.3 C14.51,4.1 14.27,4 14,4 L4,4 C3.73,4 3.5,4.1 3.3,4.3 C3.1,4.5 3,4.73 3,5 L3,27 C3,27.27 3.1,27.51 3.3,27.7 C3.5,27.9 3.73,28 4,28 L13,28 L13,30 L4,30 Z M6,8 C5.73,8 5.5,7.9 5.3,7.7 C5.1,7.51 5,7.27 5,7 C5,6.73 5.1,6.5 5.3,6.3 C5.5,6.1 5.73,6 6,6 L12,6 C12.27,6 12.51,6.1 12.7,6.3 C12.9,6.5 13,6.73 13,7 C13,7.27 12.9,7.51 12.7,7.7 C12.51,7.9 12.27,8 12,8 L6,8 Z M6,12 C5.73,12 5.5,11.9 5.3,11.7 C5.1,11.51 5,11.27 5,11 C5,10.73 5.1,10.5 5.3,10.3 C5.5,10.1 5.73,10 6,10 L9,10 L9,12 L6,12 Z M16,30 C15.73,30 15.5,29.9 15.3,29.7 C15.1,29.51 15,29.27 15,29 C15,28.77 15.04,28.59 15.13,28.47 C15.21,28.34 15.32,28.25 15.47,28.17 C15.62,28.1 15.78,28.05 15.95,28.03 C16.13,28.01 16.31,28 16.49,28 L17,28 L17,26 L14,26 C13.59,26 13.21,25.92 12.84,25.77 C12.48,25.61 12.16,25.4 11.89,25.13 C11.62,24.86 11.4,24.53 11.24,24.16 C11.07,23.78 10.99,23.4 11,23 L11,13 C11,12.59 11.08,12.21 11.24,11.84 C11.39,11.48 11.61,11.16 11.88,10.89 C12.15,10.62 12.47,10.4 12.84,10.24 C13.22,10.07 13.61,9.99 14,10 L28,10 C28.41,10 28.79,10.08 29.16,10.24 C29.52,10.39 29.84,10.61 30.11,10.88 C30.38,11.15 30.6,11.47 30.77,11.84 C30.93,12.22 31.01,12.61 31,13 L31,23 C31,23.41 30.92,23.79 30.77,24.16 C30.61,24.52 30.4,24.84 30.13,25.11 C29.86,25.38 29.53,25.6 29.16,25.77 C28.78,25.93 28.4,26.01 28,26 L25,26 L25,28 L25.53,28 C25.71,28 25.89,28.01 26.06,28.03 C26.24,28.05 26.4,28.09 26.53,28.16 C26.67,28.22 26.78,28.32 26.88,28.47 C26.97,28.62 27.01,28.79 27,29 C27,29.27 26.9,29.51 26.7,29.7 C26.51,29.9 26.27,30 26,30 L16,30 Z M28,24 C28.27,24 28.51,23.9 28.7,23.7 C28.9,23.51 29,23.27 29,23 L29,13 C29,12.73 28.9,12.5 28.7,12.3 C28.51,12.1 28.27,12 28,12 L14,12 C13.73,12 13.5,12.1 13.3,12.3 C13.1,12.5 13,12.73 13,13 L13,23 C13,23.27 13.1,23.51 13.3,23.7 C13.5,23.9 13.73,24 14,24 L28,24 Z M19,26 L19,28 L23,28 L23,26 L19,26 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="TV &amp; display options" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SCard3" Canvas.Left="1026" Canvas.Top="402" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <Viewbox Width="34" Height="34">
                    <Canvas Width="32" Height="32">
                        <!-- candado de "seguridad online y familia" - trazado real
                             tomado de Lock.svg (Microsoft.GamingApp), no aproximado -->
                        <Path Fill="White"
                              Data="M28,16 L28,28 C28,28.55 27.9,29.07 27.69,29.55 C27.48,30.03 27.19,30.45 26.83,30.83 C26.46,31.2 26.04,31.49 25.56,31.69 C25.08,31.89 24.56,31.99 24,32 L8,32 C7.45,32 6.93,31.9 6.45,31.69 C5.97,31.48 5.55,31.19 5.17,30.83 C4.8,30.46 4.51,30.04 4.31,29.56 C4.11,29.08 4.01,28.56 4,28 L4,16 C4,15.45 4.1,14.93 4.31,14.45 C4.52,13.97 4.81,13.55 5.17,13.17 C5.54,12.8 5.96,12.51 6.44,12.31 C6.92,12.11 7.44,12.01 8,12 L8,8 C8,6.9 8.21,5.86 8.63,4.89 C9.04,3.92 9.61,3.07 10.33,2.34 C11.05,1.61 11.9,1.04 12.88,0.63 C13.85,0.21 14.9,0 16,0 C17.1,0 18.14,0.21 19.11,0.63 C20.08,1.04 20.93,1.61 21.66,2.33 C22.39,3.05 22.96,3.9 23.38,4.88 C23.79,5.85 24,6.9 24,8 L24,12 C24.55,12 25.07,12.1 25.55,12.31 C26.03,12.52 26.45,12.81 26.83,13.17 C27.2,13.54 27.49,13.96 27.69,14.44 C27.89,14.92 28,15.44 28,16 Z M10,12 L22,12 L22,8 C22,7.17 21.84,6.39 21.53,5.66 C21.22,4.93 20.79,4.29 20.25,3.75 C19.71,3.21 19.07,2.78 18.34,2.47 C17.61,2.16 16.83,2 16,2 C15.17,2 14.39,2.16 13.66,2.47 C12.93,2.78 12.29,3.21 11.75,3.75 C11.21,4.29 10.78,4.93 10.47,5.66 C10.16,6.39 10,7.17 10,8 Z M18,22 C18,22.28 17.95,22.54 17.84,22.78 C17.74,23.02 17.6,23.23 17.42,23.41 C17.24,23.58 17.03,23.73 16.78,23.84 C16.53,23.96 16.27,24.01 16,24 C15.72,24 15.46,23.95 15.22,23.84 C14.98,23.74 14.77,23.6 14.58,23.42 C14.39,23.24 14.25,23.04 14.16,22.8 C14.06,22.56 14.01,22.29 14,22 C14,21.72 14.05,21.46 14.16,21.22 C14.26,20.98 14.4,20.77 14.58,20.59 C14.76,20.42 14.97,20.27 15.22,20.16 C15.47,20.04 15.73,19.99 16,20 C16.27,20 16.53,20.05 16.77,20.16 C17.01,20.26 17.22,20.4 17.41,20.58 C17.59,20.76 17.74,20.97 17.84,21.22 C17.95,21.47 18,21.73 18,22 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Online safety &amp; family" />
            </StackPanel>
        </Border>

        <!-- Fila 3 -->
        <Border Classes="settingsCard" x:Name="SCard4" Canvas.Left="567" Canvas.Top="548" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <Viewbox Width="34" Height="34">
                    <Canvas Width="32" Height="32">
                        <!-- altavoz de "volumen y salida de audio" - trazado real
                             tomado de Volume.svg (Microsoft.GamingApp), no aproximado -->
                        <Path Fill="White"
                              Data="M14.5,27.58 C14.1,27.58 13.75,27.43 13.44,27.14 L8.59,22.28 L5,22.28 C4.46,22.28 3.96,22.15 3.5,21.88 C3.04,21.6 2.68,21.24 2.41,20.78 C2.14,20.32 2,19.82 2,19.28 L2,13.28 C2,12.74 2.14,12.24 2.41,11.78 C2.68,11.32 3.04,10.96 3.5,10.69 C3.96,10.42 4.46,10.28 5,10.28 L8.59,10.28 L13.44,5.42 C13.74,5.14 14.09,5 14.5,5 C14.71,5 14.9,5.04 15.08,5.11 C15.36,5.21 15.58,5.4 15.75,5.66 C15.92,5.91 16,6.18 16,6.48 L16,26.08 C16,26.38 15.92,26.66 15.75,26.91 C15.58,27.16 15.36,27.34 15.08,27.45 C14.88,27.54 14.69,27.58 14.5,27.58 Z M24.08,26.16 C23.79,26.16 23.54,26.05 23.33,25.83 C23.15,25.63 23.06,25.41 23.06,25.17 C23.06,24.88 23.18,24.63 23.41,24.42 C24.55,23.38 25.44,22.15 26.06,20.73 C26.69,19.31 27,17.82 27,16.28 C27,14.74 26.69,13.26 26.06,11.84 C25.44,10.42 24.55,9.18 23.41,8.14 C23.18,7.93 23.06,7.68 23.06,7.39 C23.06,7.15 23.15,6.93 23.33,6.73 C23.54,6.52 23.79,6.41 24.08,6.41 C24.35,6.41 24.57,6.49 24.75,6.66 C26.1,7.9 27.15,9.35 27.89,11.03 C28.63,12.71 29,14.46 29,16.28 C29,18.1 28.63,19.85 27.89,21.53 C27.15,23.21 26.1,24.67 24.75,25.91 C24.55,26.07 24.33,26.16 24.08,26.16 Z M9.7,11.98 C9.51,12.18 9.27,12.28 9,12.28 L5,12.28 C4.73,12.28 4.49,12.38 4.3,12.58 C4.1,12.78 4,13.01 4,13.28 L4,19.28 C4,19.55 4.1,19.79 4.3,19.98 C4.49,20.18 4.73,20.28 5,20.28 L9,20.28 C9.27,20.28 9.51,20.38 9.7,20.58 L14,24.86 L14,7.69 Z M20.19,22.34 C19.93,22.34 19.72,22.27 19.56,22.13 C19.44,22.03 19.34,21.92 19.28,21.78 C19.22,21.65 19.19,21.51 19.19,21.36 C19.19,21.12 19.27,20.91 19.42,20.72 C19.93,20.09 20.32,19.4 20.59,18.64 C20.86,17.87 21,17.08 21,16.28 C21,15.48 20.86,14.7 20.59,13.94 C20.32,13.17 19.93,12.47 19.42,11.84 C19.27,11.66 19.19,11.44 19.19,11.2 C19.19,11.06 19.22,10.92 19.28,10.78 C19.34,10.65 19.44,10.53 19.56,10.44 C19.75,10.28 19.96,10.2 20.19,10.2 C20.5,10.2 20.76,10.33 20.97,10.58 C21.62,11.37 22.12,12.26 22.47,13.25 C22.82,14.23 23,15.24 23,16.28 C23,17.32 22.82,18.33 22.47,19.31 C22.12,20.29 21.62,21.18 20.97,21.98 C20.76,22.22 20.5,22.34 20.19,22.34 Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="Volume &amp; audio output" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SCard5" Canvas.Left="1026" Canvas.Top="548" Width="445" Height="133">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Power options" />
            </StackPanel>
        </Border>

        <!-- Anillos de seleccion de las 6 tarjetas: el rectangulo de cada tarjeta (445x133)
             inflado 8 por cada lado -> 461x149, con la esquina superior izquierda 8 arriba
             y 8 a la izquierda de la suya. Todo en enteros a proposito (ver el comentario
             de Border.selectionRing). Declarados despues de las tarjetas para que queden
             por encima. -->
        <Border Classes="selectionRing" x:Name="SRing0" Canvas.Left="559" Canvas.Top="248" Width="461" Height="149" />
        <Border Classes="selectionRing" x:Name="SRing1" Canvas.Left="1018" Canvas.Top="248" Width="461" Height="149" />
        <Border Classes="selectionRing" x:Name="SRing2" Canvas.Left="559" Canvas.Top="394" Width="461" Height="149" />
        <Border Classes="selectionRing" x:Name="SRing3" Canvas.Left="1018" Canvas.Top="394" Width="461" Height="149" />
        <Border Classes="selectionRing" x:Name="SRing4" Canvas.Left="559" Canvas.Top="540" Width="461" Height="149" />
        <Border Classes="selectionRing" x:Name="SRing5" Canvas.Left="1018" Canvas.Top="540" Width="461" Height="149" />

        <!-- ================================================================================
             Contenido de "System": 7 tarjetas en 4 filas (2+2+2+1). Reutiliza EXACTAMENTE la
             misma rejilla que General (columnas 567/1026, filas cada 146, tarjetas 445x133),
             porque Xbox usa el mismo layout en las dos categorias: medido en la referencia y
             coincide dentro de 1-2 px. La cuarta fila continua el mismo paso: 548+146=694.
             Nace oculto; el code-behind lo enciende al seleccionar la categoria.
             ================================================================================ -->

        <!-- Fila 1 -->
        <Border Classes="settingsCard" x:Name="SysCard0" Canvas.Left="567" Canvas.Top="256" Width="445" Height="133" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <!-- Pantalla con engranaje. APROXIMADO: el dibujo exacto de la referencia no
                     existe como fichero suelto en ninguna app de Xbox instalada (se barrieron
                     sus 240 iconos) ni como glifo identico en la fuente de iconos de Windows
                     (se revisaron los rangos E700-ECFF, ED00-EEFF y F100-F2FF). Este es el
                     glifo mas parecido que SI es real: misma idea (dispositivo + engranaje). -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xF210;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Console info" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SysCard1" Canvas.Left="1026" Canvas.Top="256" Width="445" Height="133" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0" Spacing="22">
                <!-- Unidades apiladas. APROXIMADO por el mismo motivo que "Console info": la
                     referencia dibuja una consola con una unidad externa debajo, y ese icono
                     concreto solo vive en la interfaz de la consola, no en nada instalado aqui. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE7DE;" FontFamily="Segoe Fluent Icons" FontSize="30" Foreground="White"
