<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.StoreCategoryView"
             Width="1920" Height="1080">
    <!-- PAGINA DE CATEGORIA de la Tienda (la que se abre en Apps > Music apps).
         Construida 1:1 a partir de la captura de referencia "2.png": todas las
         coordenadas, colores y tamanos de aqui estan medidos sobre ella, con el porque
         de cada numero anotado al lado. Si algo hay que retocar, mirar
         primero la captura antes de mover valores a ojo.

         Vive bajo demanda como el resto de pantallas (MainWindow la crea al entrar y la libera al
         salir), segun la arquitectura de rendimiento del proyecto. -->

    <UserControl.Styles>
        <!-- Anillo de foco al estilo Xbox medido en la captura: trazo de acento de 6 px por fuera y
             banda negra de 5 px por dentro. El color SIGUE EL TEMA del usuario (decision suya; en la
             captura era verde fijo). Se enciende con la clase "selected". -->
        <Style Selector="Border.catRing">
            <Setter Property="Background" Value="Transparent" />
            <!-- OJO: el estado sin foco es AccentFadedBrush (el acento con alpha 0), NO "Transparent".
                 "Transparent" es blanco transparente, asi que la BrushTransition de abajo interpolaba
                 el color hacia el blanco mientras bajaba el alfa y el anillo se apagaba en BLANCO en
                 vez de en el color del tema. Mismo motivo que en Border.selectionRing de la home. -->
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFadedBrush}" />
            <Setter Property="BorderThickness" Value="6" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.catRing.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource SettingsRingShadow}" />
        </Style>
        <!-- Banda negra interior del anillo (solo visible cuando el elemento esta enfocado). -->
        <Style Selector="Border.catRingInner">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.catRingInner.selected">
            <Setter Property="BorderBrush" Value="Black" />
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">

        <!-- ============================================================
             FONDO. Es el de la Store INVERTIDO: la luz teal cae en la esquina INFERIOR DERECHA
             (en la home esta arriba a la izquierda). Medido: no es un degradado diagonal - tres
             esquinas dan luminancia ~23 y la cuarta 72, cuando una diagonal dejaria dos a medio
             camino. El modelo que encaja (validado a ciegas en 16 puntos, error 1,9 sobre 255) es
             base horizontal + halo eliptico de esquina + nucleo calido.
             OJO: todos los stops del halo llevan el MISMO RGB y solo cambia el alfa. Si el ultimo
             se pusiera como "Transparent" (negro transparente), Avalonia interpolaria tambien el
             color hacia el negro y el halo saldria sucio de gris por el medio.
             ============================================================ -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0.00" Color="#1E1426" />
                    <GradientStop Offset="0.25" Color="#1A1924" />
                    <GradientStop Offset="0.60" Color="#141A1F" />
                    <GradientStop Offset="1.00" Color="#121921" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Correccion vertical medida (+3 de azul de arriba abajo en el borde izquierdo). -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#004060FF" />
                    <GradientStop Offset="1" Color="#044060FF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Halo teal de la esquina inferior derecha. -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="76.2%" RadiusY="97.6%">
                    <GradientStop Offset="0.00" Color="#FF2A5043" />
                    <GradientStop Offset="0.10" Color="#F52A5043" />
                    <GradientStop Offset="0.20" Color="#E82A5043" />
                    <GradientStop Offset="0.30" Color="#D62A5043" />
                    <GradientStop Offset="0.40" Color="#B82A5043" />
                    <GradientStop Offset="0.50" Color="#942A5043" />
                    <GradientStop Offset="0.60" Color="#702A5043" />
                    <GradientStop Offset="0.70" Color="#4A2A5043" />
                    <GradientStop Offset="0.80" Color="#262A5043" />
                    <GradientStop Offset="0.90" Color="#0D2A5043" />
                    <GradientStop Offset="1.00" Color="#002A5043" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Nucleo calido de la misma esquina. No es opcional: sin el, el rojo se queda corto entre
             3,5 y 5,4 niveles en toda la region inferior derecha (lo comprobo el verificador). -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="22%" RadiusY="30%">
                    <GradientStop Offset="0" Color="#403E5047" />
                    <GradientStop Offset="1" Color="#003E5047" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- FONDO AMBIENTE: con el foco en una TARJETA, toda la pagina se tiñe del color de esa app.
             Medido: el fondo pasa a ser un granate PLANO (para Apple Music) con una ligerisima rampa
             vertical, y encima unas manchas grises muy difusas que DESATURAN (suben verde y azul y
             dejan el rojo igual). El color base sale del propio arte: media del PNG x 0,36 (regla
             medida; una primera lectura dio 0,417 y hubo que corregirla: aquella media incluia
             las bandas apagadas de la caja). Los colores los pone el code-behind. -->
        <!-- La "mancha" difusa del fondo NO es un degradado: es EL PROPIO ARTE de la app, ampliado y
             muy desenfocado, centrado en la TARJETA ENFOCADA (comprobado en la captura de YouTube,
             donde se distingue el rojo del logo; con el rosa de Apple sobre granate era imposible
             saberlo y el primer estudio se quedo sin poder explicarlo). El code-behind le pone la
             imagen, el tamaño y la posicion. -->
        <!-- Se usa una copia YA OSCURECIDA del arte (x0,36, el mismo factor del fondo): la mezcla por
             opacidad no vale porque solo puede ACLARAR, y entonces el blanco del arte de YouTube
             salia como una mancha blanca en vez de fundirse con el gris del fondo. -->
        <!-- Va al 35% sobre el tinte: al 100% el arte manda demasiado (con Spotify, cuyo arte es casi
             negro, la pantalla entera salia negra y en la captura es gris). El tinte plano de cada
             app viene MEDIDO de su captura; esta capa solo aporta la variacion local. -->
        <!-- FUNDIDO: el fondo no cambia de golpe al pasar de una app a otra, se funde. Por eso hay DOS
             capas identicas (A y B) en vez de una: la de abajo se queda al 100% con el fondo anterior
             y la de arriba, con el nuevo, sube de 0 a 100 por encima. Asi en ningun momento del
             fundido asoma el fondo morado de la pagina por debajo (que es lo que pasaria si una se
             apagara mientras la otra se enciende). El contenedor tiene su propio fundido para el
             paso a/desde el BANNER, donde no hay fondo de app que mostrar.
             Los textos, iconos y la caja de arte siguen cambiando de golpe, a proposito. -->
        <Canvas x:Name="AmbientHost" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080"
                Opacity="0" IsHitTestVisible="False">
            <Canvas.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Canvas.Transitions>
            <Canvas x:Name="AmbientA" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
                <Canvas.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    </Transitions>
                </Canvas.Transitions>
                <Rectangle x:Name="AmbientFillA" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" />
                <Image x:Name="AmbientArtA" Stretch="UniformToFill" Opacity="0.35">
                    <Image.Effect>
                        <BlurEffect Radius="120" />
                    </Image.Effect>
                </Image>
            </Canvas>
            <Canvas x:Name="AmbientB" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0">
                <Canvas.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    </Transitions>
                </Canvas.Transitions>
                <Rectangle x:Name="AmbientFillB" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" />
                <Image x:Name="AmbientArtB" Stretch="UniformToFill" Opacity="0.35">
                    <Image.Effect>
                        <BlurEffect Radius="120" />
                    </Image.Effect>
                </Image>
            </Canvas>
        </Canvas>

        <!-- ============================================================
             BANNER (hero de la categoria). Rect medido 1705x461 en (117,58), radio 5.
             Solo se ve cuando el foco esta EN EL BANNER; al enfocar una tarjeta lo sustituye el
             bloque de datos de la app (DetailLayer, mas abajo).
             ============================================================ -->
        <Border x:Name="BannerBox" Canvas.Left="117" Canvas.Top="58" Width="1705" Height="461" CornerRadius="5"
                Background="#0E0722" ClipToBounds="True">
            <Canvas>
                <!-- Resplandor teal del arte interno, anclado en la esquina inferior derecha del
                     banner (medido: centro efectivo fuera del borde, pico #397160). -->
                <Rectangle Width="1705" Height="461">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="42%" RadiusY="130%">
                            <GradientStop Offset="0.00" Color="#FF397160" />
                            <GradientStop Offset="0.35" Color="#B0397160" />
                            <GradientStop Offset="0.65" Color="#55397160" />
                            <GradientStop Offset="1.00" Color="#00397160" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Oscurecimiento azul que baja desde la esquina superior derecha. -->
                <Rectangle Width="1705" Height="461">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="100%,0%" EndPoint="35%,75%">
                            <GradientStop Offset="0.00" Color="#CC04091A" />
                            <GradientStop Offset="0.55" Color="#6604091A" />
                            <GradientStop Offset="1.00" Color="#0004091A" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Titulo y subtitulo. Se colocan por donde cae la CIMA de las mayusculas (medido:
                     y=96 el titulo, y=186 el subtitulo, ambos con origen de maquetacion x=177);
                     como el TextBlock se ancla por su caja de linea y no por la letra, el Top lleva
                     descontado el hueco del ascendente. -->
                <!-- Fuente SEGOE UI, no la de la app (Inter): el estudio identifico Segoe UI por sus
                     proporciones (x-height/cap-height 0,708 medido frente a 0,714 de Segoe UI), y
                     con Inter -que es mas ancha- el subtitulo rompe linea antes de tiempo y las
                     medidas del estudio dejan de valer. -->
                <!-- Peso REGULAR, no SemiBold: el estudio dudaba entre los dos (asta/cap 0,157-0,169,
                     justo entre ambos) y la comparacion lado a lado del render con la captura lo
                     resolvio: con SemiBold el trazo sale un 35% mas gordo que el original. -->
                <!-- LetterSpacing 1,6: con el tamano que clava la altura de las mayusculas (63), el
                     titulo sale un 5,5% mas estrecho que el original, porque la Store usa la version
                     variable de Segoe con otro interletraje. Se compensa con el espaciado en vez de
                     agrandar la fuente, que descuadraria la altura medida. -->
                <TextBlock x:Name="BannerTitle" Canvas.Left="60" Canvas.Top="15" Text="Best music apps"
                           FontFamily="Segoe UI Variable Display" FontSize="63" LetterSpacing="1.6"
                           Foreground="White" />
                <TextBlock x:Name="BannerSubtitle" Canvas.Left="60" Canvas.Top="120" Width="795"
                           Text="Listen to your own playlists while gaming, catch up on your podcasts and more"
                           FontFamily="Segoe UI" FontSize="24" Foreground="White"
                           TextWrapping="Wrap" LineHeight="32" />

                <!-- Los 3 iconos de app del banner: 170x170, radio 6, anclados ARRIBA (su centro no
                     coincide con el del banner: 235 frente a 289). Sin sombra. -->
                <Border Canvas.Left="1016" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon0" Stretch="UniformToFill" />
                </Border>
                <Border Canvas.Left="1210" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon1" Stretch="UniformToFill" />
                </Border>
                <Border Canvas.Left="1403" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon2" Stretch="UniformToFill" />
                </Border>
            </Canvas>
        </Border>

        <!-- Anillo de foco del banner: banda negra (112,53) y trazo de acento (106,47). -->
        <Border x:Name="BannerRingInner" Classes="catRingInner" Canvas.Left="112" Canvas.Top="53"
                Width="1715" Height="471" CornerRadius="7" />
        <Border x:Name="BannerRing" Classes="catRing" Canvas.Left="106" Canvas.Top="47"
                Width="1727" Height="483" CornerRadius="7" />

        <!-- ============================================================
             BLOQUE DE DATOS DE LA APP ENFOCADA. Sustituye al banner cuando el foco esta en una
             tarjeta. Todo va suelto sobre el fondo: aqui NO hay panel ni caja. Coordenadas medidas
             en "apple music.png" y llevadas al lienzo; los textos los rellena el code-behind desde
             Assets/Icons/Store/Apps/apps.json (datos reales del catalogo de la Store).
             Los Canvas.Top llevan descontado el hueco del ascendente (~0,35 del tamano de fuente),
             porque lo medido es donde cae la CIMA de las mayusculas.
             ============================================================ -->
        <Canvas x:Name="DetailLayer" Canvas.Left="0" Canvas.Top="0" IsVisible="False">
            <!-- Categoria (miga de pan). Blanco algo apagado sobre el fondo teñido. -->
            <TextBlock x:Name="DetailCategory" Canvas.Left="114" Canvas.Top="46" Text="Best music apps"
                       FontFamily="Segoe UI" FontSize="33" FontWeight="SemiBold" Foreground="White" Opacity="0.82" />
            <!-- Titulo de la app. -->
            <TextBlock x:Name="DetailTitle" Canvas.Left="114" Canvas.Top="116" Text=""
                       FontFamily="Segoe UI Variable Display" FontSize="47" Foreground="White" />

            <!-- Contador de AMIGOS que tienen la app (icono de dos personas + numero), a la derecha
                 del titulo. Solo lo llevan algunas fichas: en la captura de Spotify sale "15" y en las
                 de Apple, YouTube y Dolby no hay nada. El code-behind lo enseña o lo esconde. -->
            <Canvas x:Name="FriendsRow" Canvas.Left="1031" Canvas.Top="140" IsVisible="False">
                <Path Fill="White" Stretch="Uniform" Width="26" Height="20"
                      Data="M9,3 A3,3 0 1,1 9,9 A3,3 0 1,1 9,3 M17,4.5 A2.4,2.4 0 1,1 17,9.3 A2.4,2.4 0 1,1 17,4.5 M9,11 C13,11 15.5,12.6 15.5,14.8 L15.5,16.5 L2.5,16.5 L2.5,14.8 C2.5,12.6 5,11 9,11 M17,11.4 C20.2,11.4 22.2,12.7 22.2,14.5 L22.2,16.5 L17.6,16.5 L17.6,14.8 C17.6,13.6 17,12.5 16,11.6 C16.3,11.5 16.6,11.4 17,11.4" />
                <TextBlock x:Name="FriendsCount" Canvas.Left="34" Canvas.Top="-3" Text=""
                           FontFamily="Segoe UI" FontSize="24" FontWeight="SemiBold" Foreground="White" />
            </Canvas>

            <!-- Las dos pastillas: valoracion (5 estrellas + votos) y genero. Van en fila con hueco
                 medido de 20 y se ajustan solas al texto, que cambia con cada app (no todas tienen
                 el mismo numero de votos ni el mismo genero). -->
            <StackPanel x:Name="PillRow" Canvas.Left="115" Canvas.Top="195" Orientation="Horizontal" Spacing="20">
                <Border Height="45" CornerRadius="7" Padding="8,0,14,0"
                        Background="#171516" BorderBrush="#58474C" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Canvas x:Name="StarHost" Width="119" Height="45" />
                        <TextBlock x:Name="RatingVotes" Text="" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"
                                   Foreground="White" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Height="45" CornerRadius="22" Padding="18,0"
                        Background="#171516" BorderBrush="#58474C" BorderThickness="1">
                    <TextBlock x:Name="GenreText" Text="" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Descripcion: 2 lineas como maximo, interlineado medido 35. -->
            <TextBlock x:Name="DetailDescription" Canvas.Left="114" Canvas.Top="291" Width="950" Text=""
                       FontFamily="Segoe UI" FontSize="25" Foreground="White" Opacity="0.60"
                       TextWrapping="Wrap" LineHeight="35" MaxLines="2" />
            <!-- Linea de ESTADO: el precio si la app no la tienes ("Free"), o el icono de circulo con
                 tick + "Owned" si ya es tuya. NO esta a una altura fija: va siempre justo debajo de la
                 ULTIMA linea de descripcion, asi que sube cuando la descripcion ocupa una sola linea
                 (medido comparando las fichas de Apple Music y de YouTube). La coloca el code-behind.
                 El icono empieza 5 px a la IZQUIERDA de la columna de texto (medido). -->
            <!-- Tamaño del texto MEDIDO en las capturas de Spotify y de Dolby, que coinciden entre si:
                 la palabra "Owned" ocupa 92,5 px de ancho de tinta en el lienzo de 1920. Con 33 salia
                 104 (un 12% mas grande, que es lo que el usuario veia). 29,5 da 93. El Canvas.Top de 2
                 mantiene el centro del texto donde estaba al bajar el tamaño. -->
            <Canvas x:Name="StatusRow" Canvas.Left="0" Canvas.Top="374">
                <Canvas x:Name="OwnedIconHost" Canvas.Left="109" Canvas.Top="0" IsVisible="False" />
                <TextBlock x:Name="DetailPrice" Canvas.Left="114" Canvas.Top="3.5" Text=""
                           FontFamily="Segoe UI" FontSize="29.5" FontWeight="SemiBold" Foreground="White" />
            </Canvas>

            <!-- Caja de arte grande. El arte de la app es CUADRADO y la caja APAISADA: la Store
                 centra el arte sin estirarlo y rellena los lados con un color derivado del propio
                 arte (medido: banda = arte x 0,26 sobre un solido). Sombra hacia abajo-derecha. -->
            <Border x:Name="DetailArtBox" Canvas.Left="1122" Canvas.Top="106" Width="690" Height="386"
                    CornerRadius="8" ClipToBounds="True" BoxShadow="6 6 27 -4 #59000000">
                <Panel>
                    <!-- Las franjas de los lados NO son un color plano: son el mismo arte ampliado y
                         desenfocado rellenando la caja (se ve en la captura de YouTube, donde en la
                         banda asoma el rojo del logo). Encima, el arte cuadrado nitido centrado. -->
                    <Image x:Name="DetailArtBlur" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="45" />
                        </Image.Effect>
                    </Image>
                    <!-- Las franjas van oscurecidas respecto al arte (medido en YouTube: blanco 255
                         del arte -> 148 en la banda, o sea ~0,58). -->
                    <Rectangle Fill="#6B000000" />
                    <Image x:Name="DetailArt" Width="387" Height="386" Stretch="UniformToFill"
                           HorizontalAlignment="Center" />
                </Panel>
            </Border>
        </Canvas>

        <!-- Avisos de arriba a la derecha (solo en el estado de detalle, medido). -->
        <Canvas x:Name="TopHints" Canvas.Left="0" Canvas.Top="0" IsVisible="False">
            <!-- Boton X del mando + FILTER -->
            <Ellipse Canvas.Left="1471" Canvas.Top="65" Width="26" Height="26" Stroke="White" StrokeThickness="2" />
            <Path Canvas.Left="1471" Canvas.Top="65" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"
                  Data="M8,8 L18,18 M18,8 L8,18" />
            <TextBlock Canvas.Left="1505" Canvas.Top="65" Text="FILTER" FontFamily="Segoe UI" FontSize="26"
                       Foreground="White" />
            <!-- Boton Menu + QUICK ACTIONS -->
            <Ellipse Canvas.Left="1599" Canvas.Top="65" Width="26" Height="26" Stroke="White" StrokeThickness="2" />
            <Path Canvas.Left="1599" Canvas.Top="65" Stroke="White" StrokeThickness="2" StrokeLineCap="Round"
                  Data="M8,9 H18 M8,13 H18 M8,17 H18" />
            <TextBlock Canvas.Left="1631" Canvas.Top="65" Text="QUICK ACTIONS" FontFamily="Segoe UI" FontSize="26"
                       Foreground="White" />
        </Canvas>

        <!-- ============================================================
             REJILLA DE TARJETAS. Las construye el code-behind (BuildGrid): 6 columnas, pitch 287,3
             (con 288 la sexta se desviaria 4 px), primera fila en y=583 y segunda en 967.
             ============================================================ -->
        <Canvas x:Name="GridHost" Canvas.Left="0" Canvas.Top="0" />

        <!-- ============================================================
             ADORNOS SUELTOS. En esta pagina NO hay panel de rail: se barrio la franja izquierda
             entera y la diferencia maxima entre pixeles contiguos es 1 unidad. Solo hay estas dos
             cosas.
             ============================================================ -->

        <!-- Indicador de 3 puntos (paginacion): el activo en BLANCO FIJO (decision del usuario), los
             otros dos al 32%. Alineado por ARRIBA con el borde exterior del anillo del banner. -->
        <Ellipse Canvas.Left="67" Canvas.Top="49" Width="8" Height="8" Fill="White" />
        <Ellipse Canvas.Left="67" Canvas.Top="61" Width="8" Height="8" Fill="White" Opacity="0.32" />
        <Ellipse Canvas.Left="67" Canvas.Top="73" Width="8" Height="8" Fill="White" Opacity="0.32" />

        <!-- QUITADO a proposito: aqui iba el aro translucido con el glifo del boton VIEW y
             su chevron, abajo a la izquierda (esta en la captura de referencia, pero no lo vamos a
             usar). Si algun dia se quiere recuperar, hay que volver a medirlo sobre
             la captura de referencia. -->

    </Canvas>
</UserControl>
