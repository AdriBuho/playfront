<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.StoreCategoryView"
             Width="1920" Height="1080">
    <!-- Store CATEGORY PAGE (the one that opens under Apps > Music apps).
         Built 1:1 from the reference capture: every coordinate, colour and size here is measured
         from it, with the reason for each number noted alongside. Re-measure against the reference
         before nudging any value by eye.

         Created on demand like every other screen (MainWindow builds it on entry and releases it
         on exit). -->

    <UserControl.Styles>
        <!-- Xbox-style focus ring measured from the reference: 6 px accent stroke outside, 5 px
             black band inside. The colour FOLLOWS THE ACTIVE THEME (the reference had it fixed
             green). Turned on with the "selected" class. -->
        <Style Selector="Border.catRing">
            <Setter Property="Background" Value="Transparent" />
            <!-- The unfocused state is AccentFadedBrush (the accent at alpha 0), NOT "Transparent".
                 "Transparent" is transparent WHITE, so the BrushTransition below interpolated the
                 colour towards white while the alpha dropped and the ring faded out through WHITE
                 instead of the theme colour. Same reason as Border.selectionRing on the home. -->
            <Setter Property="BorderBrush" Value="{DynamicResource AccentFadedBrush}" />
            <Setter Property="BorderThickness" Value="6" />
            <Setter Property="IsHitTestVisible" Value="False" />
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.catRing.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BoxShadow" Value="{DynamicResource SettingsRingShadow}" />
        </Style>
        <!-- Inner black band of the ring (only visible while the item is focused). -->
        <Style Selector="Border.catRingInner">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="5" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.catRingInner.selected">
            <Setter Property="BorderBrush" Value="Black" />
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">

        <!-- ============================================================
             BACKGROUND. The Store's, INVERTED: the teal light falls in the BOTTOM RIGHT corner (on
             the home it is top left). Measured: it is not a diagonal gradient - three corners read
             luminance ~23 and the fourth 72, whereas a diagonal would leave two halfway. The model
             that fits (validated blind on 16 sample points, error 1.9 out of 255) is horizontal
             base + elliptical corner halo + warm core.
             All halo stops carry the SAME RGB and only the alpha changes. Setting the last one to
             "Transparent" (transparent black) would make Avalonia interpolate the colour towards
             black too, and the halo would come out muddy grey in the middle.
             ============================================================ -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0.00" Color="#1E1426" />
                    <GradientStop Offset="0.25" Color="#1A1924" />
                    <GradientStop Offset="0.60" Color="#141A1F" />
                    <GradientStop Offset="1.00" Color="#121921" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Measured vertical correction (+3 blue from top to bottom along the left edge). -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#004060FF" />
                    <GradientStop Offset="1" Color="#044060FF" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Teal halo of the bottom right corner. -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="76.2%" RadiusY="97.6%">
                    <GradientStop Offset="0.00" Color="#FF2A5043" />
                    <GradientStop Offset="0.10" Color="#F52A5043" />
                    <GradientStop Offset="0.20" Color="#E82A5043" />
                    <GradientStop Offset="0.30" Color="#D62A5043" />
                    <GradientStop Offset="0.40" Color="#B82A5043" />
                    <GradientStop Offset="0.50" Color="#942A5043" />
                    <GradientStop Offset="0.60" Color="#702A5043" />
                    <GradientStop Offset="0.70" Color="#4A2A5043" />
                    <GradientStop Offset="0.80" Color="#262A5043" />
                    <GradientStop Offset="0.90" Color="#0D2A5043" />
                    <GradientStop Offset="1.00" Color="#002A5043" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- Warm core of the same corner. Not optional: without it, red falls short by 3.5 to 5.4
             levels across the whole bottom right region. -->
        <Rectangle Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
            <Rectangle.Fill>
                <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="22%" RadiusY="30%">
                    <GradientStop Offset="0" Color="#403E5047" />
                    <GradientStop Offset="1" Color="#003E5047" />
                </RadialGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- AMBIENT BACKGROUND: with focus on a CARD, the whole page takes that app's colour.
             Measured: the background becomes a FLAT maroon (for Apple Music) with a very slight
             vertical ramp, plus very diffuse grey blobs on top that DESATURATE (raise green and blue
             and leave red alone). The base colour comes from the art itself: PNG average x 0.36
             (measured rule; a first reading gave 0.417 and had to be corrected - that average
             included the dimmed side bands of the box). The code-behind sets the colours. -->
        <!-- The diffuse "blob" is NOT a gradient: it is the app's OWN ART, scaled up and heavily
             blurred, centred on the FOCUSED CARD. Confirmed on the YouTube capture, where the red of
             the logo is distinguishable; with Apple's pink over maroon it was impossible to tell.
             The code-behind sets the image, size and position. -->
        <!-- Uses an ALREADY DARKENED copy of the art (x0.36, the same factor as the background):
             blending by opacity does not work because it can only LIGHTEN, and then the white in the
             YouTube art came out as a white patch instead of merging with the grey background. -->
        <!-- Sits at 35% over the tint: at 100% the art dominates too much (with Spotify, whose art
             is nearly black, the whole screen came out black while the reference is grey). Each
             app's flat tint is MEASURED from its capture; this layer only adds local variation. -->
        <!-- CROSSFADE: the background does not snap when moving between apps, it fades. Hence TWO
             identical layers (A and B) instead of one: the bottom one stays at 100% with the old
             background while the top one, holding the new one, rises from 0 to 100 above it. That
             way the page's purple background never peeks through mid-fade (which is what would
             happen if one faded out while the other faded in). The container has its own fade for
             the transition to/from the BANNER, where there is no app background to show.
             Text, icons and the art box still snap, deliberately. -->
        <Canvas x:Name="AmbientHost" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080"
                Opacity="0" IsHitTestVisible="False">
            <Canvas.Transitions>
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                </Transitions>
            </Canvas.Transitions>
            <Canvas x:Name="AmbientA" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080">
                <Canvas.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    </Transitions>
                </Canvas.Transitions>
                <Rectangle x:Name="AmbientFillA" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" />
                <Image x:Name="AmbientArtA" Stretch="UniformToFill" Opacity="0.35">
                    <Image.Effect>
                        <BlurEffect Radius="120" />
                    </Image.Effect>
                </Image>
            </Canvas>
            <Canvas x:Name="AmbientB" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" Opacity="0">
                <Canvas.Transitions>
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                    </Transitions>
                </Canvas.Transitions>
                <Rectangle x:Name="AmbientFillB" Canvas.Left="0" Canvas.Top="0" Width="1920" Height="1080" />
                <Image x:Name="AmbientArtB" Stretch="UniformToFill" Opacity="0.35">
                    <Image.Effect>
                        <BlurEffect Radius="120" />
                    </Image.Effect>
                </Image>
            </Canvas>
        </Canvas>

        <!-- ============================================================
             BANNER (category hero). Rect measured 1705x461 at (117,58), corner radius 5.
             Only visible while focus is ON THE BANNER; focusing a card replaces it with the app
             detail block (DetailLayer, below).
             ============================================================ -->
        <Border x:Name="BannerBox" Canvas.Left="117" Canvas.Top="58" Width="1705" Height="461" CornerRadius="5"
                Background="#0E0722" ClipToBounds="True">
            <Canvas>
                <!-- Teal glow from the inner art, anchored to the banner's bottom right corner
                     (measured: effective centre outside the edge, peak #397160). -->
                <Rectangle Width="1705" Height="461">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="100%,100%" GradientOrigin="100%,100%" RadiusX="42%" RadiusY="130%">
                            <GradientStop Offset="0.00" Color="#FF397160" />
                            <GradientStop Offset="0.35" Color="#B0397160" />
                            <GradientStop Offset="0.65" Color="#55397160" />
                            <GradientStop Offset="1.00" Color="#00397160" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <!-- Blue darkening falling from the top right corner. -->
                <Rectangle Width="1705" Height="461">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="100%,0%" EndPoint="35%,75%">
                            <GradientStop Offset="0.00" Color="#CC04091A" />
                            <GradientStop Offset="0.55" Color="#6604091A" />
                            <GradientStop Offset="1.00" Color="#0004091A" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>

                <!-- Title and subtitle. Positioned by where the CAP TOP lands (measured: y=96 the
                     title, y=186 the subtitle, both with layout origin x=177); since a TextBlock is
                     anchored by its line box and not by the letter, Top has the ascender gap
                     subtracted. -->
                <!-- SEGOE UI, not the app font (Inter): identified by its proportions (x-height /
                     cap-height 0.708 measured against 0.714 for Segoe UI). With Inter - which is
                     wider - the subtitle wraps too early and the measurements stop holding. -->
                <!-- REGULAR weight, not SemiBold: the metrics were ambiguous (stem/cap 0.157-0.169,
                     right between the two) and a side-by-side of the render against the reference
                     settled it: with SemiBold the stroke comes out 35% heavier than the original. -->
                <!-- LetterSpacing 1.6: at the size that nails the cap height (63), the title comes
                     out 5.5% narrower than the original, because the Store uses the variable Segoe
                     with different tracking. Compensated with spacing rather than a bigger font,
                     which would break the measured height. -->
                <TextBlock x:Name="BannerTitle" Canvas.Left="60" Canvas.Top="15" Text="Best music apps"
                           FontFamily="Segoe UI Variable Display" FontSize="63" LetterSpacing="1.6"
                           Foreground="White" />
                <TextBlock x:Name="BannerSubtitle" Canvas.Left="60" Canvas.Top="120" Width="795"
                           Text="Listen to your own playlists while gaming, catch up on your podcasts and more"
                           FontFamily="Segoe UI" FontSize="24" Foreground="White"
                           TextWrapping="Wrap" LineHeight="32" />

                <!-- The banner's 3 app icons: 170x170, radius 6, anchored TOP (their centre does not
                     match the banner's: 235 against 289). No shadow. -->
                <Border Canvas.Left="1016" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon0" Stretch="UniformToFill" />
                </Border>
                <Border Canvas.Left="1210" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon1" Stretch="UniformToFill" />
                </Border>
                <Border Canvas.Left="1403" Canvas.Top="92" Width="170" Height="170" CornerRadius="6" ClipToBounds="True">
                    <Image x:Name="BannerIcon2" Stretch="UniformToFill" />
                </Border>
            </Canvas>
        </Border>

        <!-- Banner focus ring: black band (112,53) and accent stroke (106,47). -->
        <Border x:Name="BannerRingInner" Classes="catRingInner" Canvas.Left="112" Canvas.Top="53"
                Width="1715" Height="471" CornerRadius="7" />
        <Border x:Name="BannerRing" Classes="catRing" Canvas.Left="106" Canvas.Top="47"
                Width="1727" Height="483" CornerRadius="7" />

        <!-- ============================================================
             DETAIL BLOCK OF THE FOCUSED APP. Replaces the banner when focus is on a card. Everything
             sits loose on the background: there is NO panel or box here. Coordinates measured on the
             Apple Music reference and mapped onto the canvas; the code-behind fills the text from
             Assets/Icons/Store/Apps/apps.json (real Store catalogue data).
             Canvas.Top values have the ascender gap subtracted (~0.35 of the font size), because
             what was measured is where the CAP TOP lands.
             ============================================================ -->
        <Canvas x:Name="DetailLayer" Canvas.Left="0" Canvas.Top="0" IsVisible="False">
            <!-- Category (breadcrumb). Slightly dimmed white over the tinted background. -->
            <!-- Header. NOT the subcategory's name: on the console the two are different texts -
                 "Entertainment apps" is headed "Top entertainment apps for you", "Apps with trials" is
                 headed "Start your free trial". Set from the category's own data. -->
            <TextBlock x:Name="DetailCategory" Canvas.Left="114" Canvas.Top="46" Text=""
                       FontFamily="Segoe UI" FontSize="33" FontWeight="SemiBold" Foreground="White" Opacity="0.82" />
            <!-- App title. -->
            <TextBlock x:Name="DetailTitle" Canvas.Left="114" Canvas.Top="116" Text=""
                       FontFamily="Segoe UI Variable Display" FontSize="47" Foreground="White" />

            <!-- The reference puts a "friends who own this" counter right of the title. It is not
                 drawn, for the same reason as the star rating: Playfront has no friends list, so the
                 number could only ever be made up. It comes back with a real one behind it.

                 The genre pill, sized to its text. It sits where the reference has two: the star
                 rating that went beside it is NOT drawn, because we have no real review scores and a
                 made-up number of stars is worse than no stars. It comes back when the figures do. -->
            <StackPanel x:Name="PillRow" Canvas.Left="115" Canvas.Top="195" Orientation="Horizontal" Spacing="20">
                <Border x:Name="GenrePill" Height="45" CornerRadius="22" Padding="18,0"
                        Background="#171516" BorderBrush="#58474C" BorderThickness="1">
                    <TextBlock x:Name="GenreText" Text="" FontFamily="Segoe UI" FontSize="25" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center" />
                </Border>
            </StackPanel>

            <!-- Description: 2 lines maximum, measured line height 35. -->
            <TextBlock x:Name="DetailDescription" Canvas.Left="114" Canvas.Top="291" Width="950" Text=""
                       FontFamily="Segoe UI" FontSize="25" Foreground="White" Opacity="0.60"
                       TextWrapping="Wrap" LineHeight="35" MaxLines="2" />
            <!-- STATUS line: the price when the app is not owned ("Free"), or the circled tick icon
                 + "Owned" when it is. NOT at a fixed height: it always sits right under the LAST
                 description line, so it moves up when the description is a single line (measured by
                 comparing the Apple Music and YouTube entries). The code-behind positions it.
                 The icon starts 5 px LEFT of the text column (measured). -->
            <!-- Text size MEASURED on the Spotify and Dolby captures, which agree with each other:
                 the word "Owned" occupies 92.5 px of ink width on the 1920 canvas. At 33 it came out
                 104 (12% too large). 29.5 gives 93. The Canvas.Top of 2 keeps the text centre where
                 it was after shrinking the size. -->
            <Canvas x:Name="StatusRow" Canvas.Left="0" Canvas.Top="374">
                <Canvas x:Name="OwnedIconHost" Canvas.Left="109" Canvas.Top="0" IsVisible="False" />
                <TextBlock x:Name="DetailPrice" Canvas.Left="114" Canvas.Top="3.5" Text=""
                           FontFamily="Segoe UI" FontSize="29.5" FontWeight="SemiBold" Foreground="White" />
            </Canvas>

            <!-- Large art box. The app art is SQUARE and the box is LANDSCAPE: the Store centres the
                 art without stretching it and fills the sides with a colour derived from the art
                 itself (measured: band = art x 0.26 over a solid). Shadow towards bottom right. -->
            <Border x:Name="DetailArtBox" Canvas.Left="1122" Canvas.Top="106" Width="690" Height="386"
                    CornerRadius="8" ClipToBounds="True" BoxShadow="6 6 27 -4 #59000000">
                <Panel>
                    <!-- The side bands are NOT a flat colour: they are the same art scaled up and
                         blurred to fill the box (visible on the YouTube reference, where the red of
                         the logo shows through the band). On top, the sharp square art, centred. -->
                    <Image x:Name="DetailArtBlur" Stretch="UniformToFill">
                        <Image.Effect>
                            <BlurEffect Radius="45" />
                        </Image.Effect>
                    </Image>
                    <!-- The bands are darkened relative to the art (measured on YouTube: white 255
                         in the art -> 148 in the band, i.e. ~0.58). -->
                    <Rectangle Fill="#6B000000" />
                    <Image x:Name="DetailArt" Width="387" Height="386" Stretch="UniformToFill"
                           HorizontalAlignment="Center" />
                </Panel>
            </Border>
        </Canvas>

        <!-- Top right hints (detail state only).
             Measured on the console: both glyphs are 24 x 24 at y=65, on x=1470 and x=1597; the
             labels' ink starts on 1504 and 1630 with the caps between y 69 and 85. The gaps are
             10 px glyph-to-label and 26 px label-to-next-glyph, and QUICK ACTIONS ends on 1806.

             The glyphs are the OFFICIAL Xbox app SVGs (ButtonX.svg / ButtonMenu.svg), the same
             files the Home and Library hints use - not a ring with a hand-drawn cross. The X one
             carries a LETTER x, not two crossed strokes, which the drawn version got wrong. -->
        <Canvas x:Name="TopHints" Canvas.Left="0" Canvas.Top="0" IsVisible="False">
            <Viewbox Canvas.Left="1470" Canvas.Top="65" Width="24" Height="24">
                <Canvas Width="32" Height="32">
                    <!-- "F0" = even-odd fill, which is what leaves the ring hollow. -->
                    <Path Fill="White" Data="F0 M16,0 C24.836556,0 32,7.163444 32,16 C32,24.836556 24.836556,32 16,32 C7.163444,32 0,24.836556 0,16 C0,7.163444 7.163444,0 16,0 Z M16,2 C8.2680135,2 2,8.2680135 2,16 C2,23.7319865 8.2680135,30 16,30 C23.7319865,30 30,23.7319865 30,16 C30,8.2680135 23.7319865,2 16,2 Z M10.688,9.906 L14.031,9.906 L15.75,13.562 C15.833,13.729 15.906,13.901 15.969,14.078 C16.031,14.245 16.083,14.417 16.125,14.594 L16.172,14.594 L16.2173333,14.421963 L16.328,14.047 C16.37525,13.891 16.428125,13.751875 16.486625,13.6308906 L18.484,9.906 L21.531,9.906 L17.891,15.938 L21.641,22.094 L18.375,22.094 L16.297,18.125 C16.234,18 16.182,17.87 16.141,17.734 L16.047,17.312 L16.016,17.312 C15.9946667,17.4026667 15.9693333,17.4977778 15.9394074,17.5973333 L15.891,17.75 C15.849,17.906 15.797,18.042 15.734,18.156 L13.625,22.094 L10.359,22.094 L14.234,16 L10.688,9.906 Z" />
                </Canvas>
            </Viewbox>
            <TextBlock Canvas.Left="1502" Canvas.Top="62" Text="FILTER"
                       FontFamily="{StaticResource XboxFontSemibold}" FontSize="24" Foreground="White" />

            <Viewbox Canvas.Left="1597" Canvas.Top="65" Width="24" Height="24">
                <Canvas Width="32" Height="32">
                    <Path Fill="White" Data="M16,0 C24.836556,0 32,7.163444 32,16 C32,24.836556 24.836556,32 16,32 C7.163444,32 0,24.836556 0,16 C0,7.163444 7.163444,0 16,0 Z M16,2 C8.2680135,2 2,8.2680135 2,16 C2,23.7319865 8.2680135,30 16,30 C23.7319865,30 30,23.7319865 30,16 C30,8.2680135 23.7319865,2 16,2 Z M23,20 C23.2708,20 23.5052,20.1 23.7031,20.3 C23.901,20.49 24,20.73 24,21 C24,21.27 23.901,21.51 23.7031,21.7 C23.5052,21.9 23.2708,22 23,22 L9,22 C8.72917,22 8.49479,21.9 8.29688,21.7 C8.09896,21.51 8,21.27 8,21 C8,20.73 8.09896,20.49 8.29688,20.3 C8.49479,20.1 8.72917,20 9,20 L23,20 Z M23,15 C23.2708,15 23.5052,15.1 23.7031,15.3 C23.901,15.49 24,15.73 24,16 C24,16.27 23.901,16.51 23.7031,16.7 C23.5052,16.9 23.2708,17 23,17 L9,17 C8.72917,17 8.49479,16.9 8.29688,16.7 C8.09896,16.51 8,16.27 8,16 C8,15.73 8.09896,15.49 8.29688,15.3 C8.49479,15.1 8.72917,15 9,15 L23,15 Z M23,10 C23.2708,10 23.5052,10.1 23.7031,10.3 C23.901,10.49 24,10.73 24,11 C24,11.27 23.901,11.51 23.7031,11.7 C23.5052,11.9 23.2708,12 23,12 L9,12 C8.72917,12 8.49479,11.9 8.29688,11.7 C8.09896,11.51 8,11.27 8,11 C8,10.73 8.09896,10.49 8.29688,10.3 C8.49479,10.1 8.72917,10 9,10 L23,10 Z" />
                </Canvas>
            </Viewbox>
            <TextBlock Canvas.Left="1629" Canvas.Top="62" Text="QUICK ACTIONS"
                       FontFamily="{StaticResource XboxFontSemibold}" FontSize="24" Foreground="White" />
        </Canvas>

        <!-- ============================================================
             CARD GRID. Built by the code-behind (BuildGrid): 6 columns, pitch 287.3 (with 288 the
             sixth would drift 4 px), first row at y=583 and second at 967.
             ============================================================ -->
        <Canvas x:Name="GridHost" Canvas.Left="0" Canvas.Top="0" />

        <!-- ============================================================
             LOOSE ORNAMENTS. This page has NO rail panel: the entire left strip was swept and the
             maximum difference between adjacent pixels is 1 unit. Only these two things exist.
             ============================================================ -->

        <!-- 3-dot pagination indicator: the active one is FIXED WHITE (it does not follow the theme),
             the other two at 32%. TOP-aligned with the outer edge of the banner ring. -->
        <Ellipse Canvas.Left="67" Canvas.Top="49" Width="8" Height="8" Fill="White" />
        <Ellipse Canvas.Left="67" Canvas.Top="61" Width="8" Height="8" Fill="White" Opacity="0.32" />
        <Ellipse Canvas.Left="67" Canvas.Top="73" Width="8" Height="8" Fill="White" Opacity="0.32" />

        <!-- DELIBERATELY OMITTED: the translucent ring with the VIEW button glyph and its chevron
             went here, bottom left. It is present in the reference but is not used. Restoring it
             means re-measuring it against the reference. -->

    </Canvas>
</UserControl>
