# Line endings and file types.
#
# Without this file every clone gets whatever line endings the local git config decides.
# A .cmd or .ps1 with Unix line endings can fail to run on Windows.

# --- Scripts Windows executes: always CRLF ---
*.cmd   text eol=crlf
*.bat   text eol=crlf
*.ps1   text eol=crlf
*.psm1  text eol=crlf
*.psd1  text eol=crlf

# --- Normal text: normalized on commit, checked out in the platform format ---
*.cs     text
*.axaml  text
*.csproj text
*.slnx   text
*.props  text
*.md     text
*.json   text

# --- Binaries: git must not convert them or try to diff them as text ---
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.svg   text
*.ttf   binary
*.otf   binary
*.mp4   binary
*.exe   binary
*.dll   binary
*.zip   binary
