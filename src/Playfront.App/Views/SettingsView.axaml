<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pf="clr-namespace:Playfront.App"
             x:Class="Playfront.App.Views.SettingsView"
             Width="1920" Height="1080">
    <!-- Settings screen (1:1 with Xbox's General). Split out of MainWindow into its own view so it
         loads ON DEMAND: the window only builds Home at startup; this view is created on entering
         Settings (MainWindow.EnterSettings) and released on exit (ExitSettings), so it is not resident.
         The styles (Border.settingsNavItem / settingsCard / selectionRing) and theme resources
         (AccentBrush, SettingsHighlightShadow) live on the window/app and CASCADE down here, so they
         are not duplicated. Navigation lives in the code-behind; leaving this screen (opening
         Personalization, returning Home) is signalled by events. -->
    <Canvas Width="1920" Height="1080">
        <Canvas.Resources>
            <!-- Icon drawings used by MORE THAN ONE card, kept here so the path data exists once.
                 Both are the real files from the installed Xbox app's icon set (Lock.svg,
                 MultiPlayer.svg), on a 32x32 canvas like the rest. A card that uses its drawing
                 only once still inlines it, next to the comment that says where it came from. -->
            <StreamGeometry x:Key="IconLock">M28,16 L28,28 C28,28.55 27.9,29.07 27.69,29.55 C27.48,30.03 27.19,30.45 26.83,30.83 C26.46,31.2 26.04,31.49 25.56,31.69 C25.08,31.89 24.56,31.99 24,32 L8,32 C7.45,32 6.93,31.9 6.45,31.69 C5.97,31.48 5.55,31.19 5.17,30.83 C4.8,30.46 4.51,30.04 4.31,29.56 C4.11,29.08 4.01,28.56 4,28 L4,16 C4,15.45 4.1,14.93 4.31,14.45 C4.52,13.97 4.81,13.55 5.17,13.17 C5.54,12.8 5.96,12.51 6.44,12.31 C6.92,12.11 7.44,12.01 8,12 L8,8 C8,6.9 8.21,5.86 8.63,4.89 C9.04,3.92 9.61,3.07 10.33,2.34 C11.05,1.61 11.9,1.04 12.88,0.63 C13.85,0.21 14.9,0 16,0 C17.1,0 18.14,0.21 19.11,0.63 C20.08,1.04 20.93,1.61 21.66,2.33 C22.39,3.05 22.96,3.9 23.38,4.88 C23.79,5.85 24,6.9 24,8 L24,12 C24.55,12 25.07,12.1 25.55,12.31 C26.03,12.52 26.45,12.81 26.83,13.17 C27.2,13.54 27.49,13.96 27.69,14.44 C27.89,14.92 28,15.44 28,16 Z M10,12 L22,12 L22,8 C22,7.17 21.84,6.39 21.53,5.66 C21.22,4.93 20.79,4.29 20.25,3.75 C19.71,3.21 19.07,2.78 18.34,2.47 C17.61,2.16 16.83,2 16,2 C15.17,2 14.39,2.16 13.66,2.47 C12.93,2.78 12.29,3.21 11.75,3.75 C11.21,4.29 10.78,4.93 10.47,5.66 C10.16,6.39 10,7.17 10,8 Z M18,22 C18,22.28 17.95,22.54 17.84,22.78 C17.74,23.02 17.6,23.23 17.42,23.41 C17.24,23.58 17.03,23.73 16.78,23.84 C16.53,23.96 16.27,24.01 16,24 C15.72,24 15.46,23.95 15.22,23.84 C14.98,23.74 14.77,23.6 14.58,23.42 C14.39,23.24 14.25,23.04 14.16,22.8 C14.06,22.56 14.01,22.29 14,22 C14,21.72 14.05,21.46 14.16,21.22 C14.26,20.98 14.4,20.77 14.58,20.59 C14.76,20.42 14.97,20.27 15.22,20.16 C15.47,20.04 15.73,19.99 16,20 C16.27,20 16.53,20.05 16.77,20.16 C17.01,20.26 17.22,20.4 17.41,20.58 C17.59,20.76 17.74,20.97 17.84,21.22 C17.95,21.47 18,21.73 18,22 Z</StreamGeometry>
            <StreamGeometry x:Key="IconMultiPlayer">M11,15 C9.73958,15 8.57292,14.69 7.5,14.06 C6.42708,13.43 5.57292,12.57 4.9375,11.5 C4.3125,10.43 4,9.26 4,8 C4,6.74 4.3125,5.57 4.9375,4.5 C5.57292,3.43 6.42708,2.58 7.5,1.95 C8.57292,1.32 9.73958,1 11,1 C12.2604,1 13.4271,1.32 14.5,1.95 C15.5729,2.58 16.4219,3.43 17.0469,4.5 C17.6823,5.57 18,6.74 18,8 C18,9.26 17.6823,10.43 17.0469,11.5 C16.4219,12.57 15.5729,13.43 14.5,14.06 C13.4271,14.69 12.2604,15 11,15 Z M11,13 C11.9062,13 12.7396,12.78 13.5,12.33 C14.2708,11.88 14.8802,11.28 15.3281,10.52 C15.776,9.74 16,8.91 16,8 C16,7.09 15.776,6.26 15.3281,5.5 C14.8802,4.73 14.2708,4.12 13.5,3.67 C12.7396,3.22 11.9062,3 11,3 C10.0938,3 9.25521,3.22 8.48438,3.67 C7.72396,4.12 7.11979,4.73 6.67188,5.5 C6.22396,6.26 6,7.09 6,8 C6,8.91 6.22396,9.74 6.67188,10.52 C7.11979,11.28 7.72396,11.88 8.48438,12.33 C9.25521,12.78 10.0938,13 11,13 Z M25,15 C24.0938,15 23.2552,14.78 22.4844,14.33 C21.724,13.88 21.1198,13.28 20.6719,12.52 C20.224,11.74 20,10.91 20,10 C20,9.09 20.224,8.26 20.6719,7.5 C21.1198,6.73 21.724,6.12 22.4844,5.67 C23.2552,5.22 24.0938,5 25,5 C25.9062,5 26.7396,5.22 27.5,5.67 C28.2708,6.12 28.8802,6.73 29.3281,7.5 C29.776,8.26 30,9.09 30,10 C30,10.91 29.776,11.74 29.3281,12.52 C28.8802,13.28 28.2708,13.88 27.5,14.33 C26.7396,14.78 25.9062,15 25,15 Z M25,13 C25.5417,13 26.0417,12.86 26.5,12.59 C26.9583,12.32 27.3229,11.96 27.5938,11.5 C27.8646,11.04 28,10.54 28,10 C28,9.46 27.8646,8.96 27.5938,8.5 C27.3229,8.04 26.9583,7.68 26.5,7.41 C26.0417,7.14 25.5417,7 25,7 C24.4583,7 23.9583,7.14 23.5,7.41 C23.0417,7.68 22.6771,8.04 22.4062,8.5 C22.1354,8.96 22,9.46 22,10 C22,10.54 22.1354,11.04 22.4062,11.5 C22.6771,11.96 23.0417,12.32 23.5,12.59 C23.9583,12.86 24.4583,13 25,13 Z M11,31 C8.44792,31 6.34896,30.53 4.70312,29.58 C3.05729,28.62 1.85938,27.39 1.10938,25.88 C0.369792,24.36 0,22.74 0,21 C0,20.28 0.145833,19.61 0.4375,19 C0.739583,18.39 1.14062,17.9 1.64062,17.55 C2.15104,17.18 2.70833,17 3.3125,17 L18.6875,17 C19.2917,17 19.8438,17.18 20.3438,17.55 C20.8542,17.9 21.2552,18.39 21.5469,19 C21.849,19.61 22,20.28 22,21 C22,22.74 21.625,24.36 20.875,25.88 C20.1354,27.39 18.9427,28.62 17.2969,29.58 C15.651,30.53 13.5521,31 11,31 Z M21.8281,29 C22.3385,28.36 22.776,27.68 23.1406,26.95 C25.3281,26.79 27.0156,26.15 28.2031,25.03 C29.401,23.92 30,22.41 30,20.5 C30,20.09 29.8906,19.74 29.6719,19.45 C29.4635,19.15 29.2135,19 28.9219,19 L24.2188,19 C23.9896,18.24 23.6719,17.57 23.2656,17 L28.9219,17 C29.4844,17 30,17.16 30.4688,17.47 C30.9375,17.78 31.3073,18.21 31.5781,18.75 C31.8594,19.28 32,19.86 32,20.5 C32,21.98 31.6615,23.36 30.9844,24.64 C30.3073,25.92 29.2188,26.97 27.7188,27.78 C26.2292,28.59 24.3229,29 22,29 L21.8281,29 Z M11,29 C12.8958,29 14.5156,28.69 15.8594,28.06 C17.2135,27.44 18.2396,26.53 18.9375,25.33 C19.6458,24.13 20,22.69 20,21 C20,20.66 19.9375,20.33 19.8125,20.03 C19.6979,19.72 19.5365,19.47 19.3281,19.28 C19.1302,19.09 18.9167,19 18.6875,19 L3.3125,19 C3.08333,19 2.86458,19.09 2.65625,19.28 C2.45833,19.47 2.29688,19.72 2.17188,20.03 C2.05729,20.33 2,20.66 2,21 C2,22.69 2.34896,24.13 3.04688,25.33 C3.75521,26.53 4.78125,27.44 6.125,28.06 C7.47917,28.69 9.10417,29 11,29 Z</StreamGeometry>
        </Canvas.Resources>

        <Rectangle Width="1920" Height="1080" Fill="#201F1F" />
        <!-- Sidebar divider. 2 px at x 480-481, not 1: the reference shows two full-strength
             columns with clean shoulders either side, which a 1 px line cannot produce. #484848 is
             the value read off the reference (the old #3A3A3A was visibly darker). Declared before
             the nav rows on purpose, so the selected row's accent block paints over it - the
             reference does the same. -->
        <Rectangle Canvas.Left="480" Canvas.Top="0" Width="2" Height="1080" Fill="#484848" />

        <!-- Header: gear + avatar + user name in a horizontal StackPanel, so the three
             stay vertically centred against each other without hand-computing a
             Canvas.Top for each (they all have different heights).

             MEASURED against a 1920x1080 reference capture, which is 1:1 with this canvas, so these
             are the reference's own pixel values with no conversion:
               gear   ink x 109..142, y 67..102  (34x36), centre (125.5, 84.5)
               avatar circle centred (178.5, 84.5), diameter 38
               name   ink starts x=214, cap top y=78, cap height 17

             How the numbers below produce that: a Segoe Fluent Icons glyph advances one em, so each
             TextBlock is exactly FontSize wide, and its ink is ~0.936 of that. Gear 36 -> ~34 of ink
             starting 1 px in, hence Canvas.Left 108. Spacing 15.5 then lands the avatar at 159.5 and
             the name ink at 214; both gaps agreeing on the same spacing is what confirms the model.

             FONT: XboxFontFamily EXPLICITLY (see App.axaml). The app's default is Inter (Program.cs
             calls WithInterFont) - different cap-height ratio and different widths, so leaving it
             to the default made the name both wrong-sized and wrong-shaped.
             Cap height 17 / 0.70 = 24 gives the FontSize. -->
        <StackPanel Canvas.Left="108" Canvas.Top="66" Orientation="Horizontal" Spacing="15.5">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White" VerticalAlignment="Center" />
            <Border Width="38" Height="38" CornerRadius="19" ClipToBounds="True" VerticalAlignment="Center">
                <Image Source="/Assets/Icons/avatar.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="SettingsUserNameText" FontFamily="{StaticResource XboxFontFamily}" Foreground="White" FontSize="24" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Category list -->

        <!-- Shared highlight for the selected category: ONE accent rectangle that SLIDES
             between rows (animated translateY) instead of each settingsNavItem toggling
             its own background - that read as a flicker (off here, on there) rather than
             the fluid movement the real Xbox has. Declared BEFORE the SNavX items (so
             behind them in z-order) to keep each category's text legible on top. Its base
             Canvas.Top matches SNav1 ("General", the default category on opening
             Settings); the code-behind moves it with translateY relative to that base,
             and hides it entirely while focus is inside the card grid. -->
        <Border x:Name="SettingsNavHighlight" Canvas.Left="0" Canvas.Top="276" Width="482" Height="64"
                CornerRadius="4" Background="{DynamicResource AccentBrush}" BoxShadow="{DynamicResource SettingsHighlightShadow}">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseInOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- "Category open" indicator - takes over from SettingsNavHighlight the moment
             focus enters the card grid: the solid accent block is for navigating the
             list, but which category is open still has to be readable while moving
             through cards. Faint grey strip (same tone as settingsCard) plus a thin
             accent bar against the right edge, next to the sidebar divider. Uses the same
             translateY mechanism as SettingsNavHighlight, off the same base Canvas.Top
             (276 = the "General" row), so both share one offset in the code-behind. -->
        <Border x:Name="SettingsCategoryIndicator" Canvas.Left="0" Canvas.Top="276" Width="482" Height="64"
                Background="#303030" IsVisible="False">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="QuadraticEaseInOut" />
                </Transitions>
            </Border.Transitions>
            <Rectangle Width="4" Height="64" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
        </Border>

        <!-- Row tops measured off the reference. "Recommendations" stands alone at 176; the list
             proper starts at 276 and steps by 68 from there. The 100 px between the two is NOT the
             row step and must not be "tidied up" to one - the reference really does open that gap
             for the divider.

             Rows are 64 tall (see Border.settingsNavItem), so the step leaves a 4 px gap. Anchor
             used for every top: the selected row's accent block, whose solid extent is y 276..339
             for "General", and the label cap centres, which land 2 px below each row's centre -
             the same 2 px on all seven, which is what confirms the grid rather than one lucky row.

             Changing any of these means changing NavTops in the code-behind too: the highlight
             slides by a translateY computed from that array, so a mismatch shows up as the block
             landing between rows. -->
        <Border Classes="settingsNavItem" x:Name="SNav0" Canvas.Left="0" Canvas.Top="176"><TextBlock Text="Recommendations" /></Border>
        <!-- Divider: 1 px at y 247, inset 40 from each side of the 482-wide sidebar. It sits in
             the gap, NOT flush against either row - it is 7 px below "Recommendations" and 29 px
             above "General". Asymmetric on purpose, that is where the reference puts it. -->
        <Rectangle Canvas.Left="40" Canvas.Top="247" Width="402" Height="1" Fill="#484848" />
        <Border Classes="settingsNavItem" x:Name="SNav1" Canvas.Left="0" Canvas.Top="276"><TextBlock Text="General" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav2" Canvas.Left="0" Canvas.Top="344"><TextBlock Text="Account" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav3" Canvas.Left="0" Canvas.Top="412"><TextBlock Text="System" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav4" Canvas.Left="0" Canvas.Top="480"><TextBlock Text="Devices &amp; connections" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav5" Canvas.Left="0" Canvas.Top="548"><TextBlock Text="Preferences" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav6" Canvas.Left="0" Canvas.Top="616"><TextBlock Text="Cloud gaming" /></Border>
        <Border Classes="settingsNavItem" x:Name="SNav7" Canvas.Left="0" Canvas.Top="684"><TextBlock Text="Accessibility" /></Border>

        <!-- Category title. Reference ink: x 530..693, y 71..104 (164 x 34).

             The DISPLAY SEMIBOLD cut, and both halves of that matter. Overlaying the reference's
             own capital G against every candidate (blurred equally, since the reference is
             compressed video) ranks the Semibold cuts far ahead of Regular and puts Light last, and
             among those the Display cut wins. Ink widths alone cannot decide this - Regular and
             Semibold in this family set almost the same widths - so the shape is the evidence.
             45 matches the ink height (34).

             THE FACE IS STILL NOT RIGHT, and the other category titles are what prove it.
             Reference ink widths, all at ink height 34, against what this cut gives at 45:

                 title                     reference   this cut
                 "General"                     164        154
                 "Account"                     170        173
                 "Devices & connections"       477        463
                 "Preferences"                 256        238

             Three short, one long, at one size. No size or tracking value fixes that, because the
             widths RELATIVE TO EACH OTHER are wrong, and only a different typeface changes those.
             An earlier LetterSpacing of 1.8 was fitted to "General" alone and looked right;
             "Account" then came out 14 px over. Removed - better to carry the font's own error
             than a fudge that only holds for one word.
             A candidate face must reproduce ALL THREE numbers before it is believed.

             Canvas.Top: the TextBlock's box starts ~13 px above the ink at this size. -->
        <!-- Everything to the right of the category list lives in here so a category change can slide
             it in as one piece. Must be a Canvas: a Panel ignores the Canvas.Left/Top of its children
             and the whole grid would collapse into the top-left corner.

             Durations and curve are the console's, measured frame by frame - see ConsoleSettleEasing.
             The left column stays put, as it does on the console. -->
        <Canvas x:Name="SContentAnim" Width="1920" Height="1080">
            <Canvas.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.79">
                        <TransformOperationsTransition.Easing>
                            <pf:ConsoleSettleEasing />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6">
                        <DoubleTransition.Easing>
                            <pf:ConsoleSettleEasing />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Canvas.Transitions>

        <TextBlock x:Name="SettingsCategoryTitle" Canvas.Left="529" Canvas.Top="58" Text="General"
                   Foreground="White" FontFamily="{StaticResource XboxFontDisplaySemibold}" FontSize="45" />

        <!-- CARD GRID, measured off the reference. Every card in this file (General and System)
             uses it, so change it here and everywhere at once:
               card      438 x 132
               columns   x 570 and 1024  (step 454, so a 16 px gutter)
               rows      y 190, 338, 486 (step 148), System's fourth row continues to 634
               icon box  36 x 36, its left edge 34 in from the card, vertically centred
               label     ink starts 101 in from the card

             How the numbers below produce that: the card carries Padding 3, so the StackPanel's
             Margin of 31 puts the icon box at 34. Icon 36 wide + Spacing 29 puts the label origin
             at 99, and Segoe UI's own left bearing lands the ink on 101.

             The icon box is what all six agree on, not the drawings: the wide ones (wifi+gear,
             brush) fill 36x36, the narrow ones (cables 26, padlock 28) sit centred inside the same
             box, and the speaker is 31x26 centred both ways. That is why the glyphs are set at
             FontSize 36 and the Viewboxes at 36 - anything smaller and the icon floats in its box.

             Selection rings follow the old rule unchanged: the card rectangle inflated 8 per side,
             so 454 x 148 with its corner 8 up and 8 left. -->
        <!-- Row 1 -->
        <Border Classes="settingsCard selected" x:Name="SCard0" Canvas.Left="570" Canvas.Top="190" Width="438" Height="132">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- Real system icon, not an approximation: it does not exist as a
                     standalone file in the installed Xbox app, but it does exist as a
                     single ready-made wifi+gear glyph in the Windows 11 icon font
                     "Segoe Fluent Icons" (code F080) - the same drawing. This used to be
                     two separate icons composed together. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xF080;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Network settings" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SCard1" Canvas.Left="1024" Canvas.Top="190" Width="438" Height="132">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE771;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Personalization" />
            </StackPanel>
        </Border>

        <!-- Row 2 -->
        <Border Classes="settingsCard" x:Name="SCard2" Canvas.Left="570" Canvas.Top="338" Width="438" Height="132">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36"><Viewbox>
                    <Canvas Width="32" Height="32">
                        <!-- The reference drawing (two cables/connectors) does not exist
                             standalone anywhere reachable - not in the Xbox app's own SVGs
                             nor in the Windows icon font (4000+ glyphs checked) - and two
                             hand-traced attempts were not legible enough at this size.
                             Replaced with "PC1.svg", a real devices/display icon from the
                             installed Xbox app's own set, even though it is not the exact
                             drawing in the reference. -->
                        <Path Fill="White"
