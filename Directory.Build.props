<Project>

  <!-- Properties shared by EVERY project in the repository (MSBuild picks this file up on its own,
       nothing references it). It exists for the version number: every release has to carry a visible
       version, and keeping it in ONE place stops the app, the service and the installer disagreeing.

       Changing PlayfrontVersion updates, in one go:
         - the .exe properties Windows shows (Explorer's Details tab),
         - what PlayfrontVersion.Current returns at runtime (src/Playfront.App/PlayfrontVersion.cs),
         - what gets written to the log on startup (%LocalAppData%\Playfront\playfront.log),
         - and the version the installer stamps.

       NUMBERING: bump the THIRD digit per release - 0.1.1, 0.1.2, 0.1.3 ... 0.1.87. No ceiling; the
       plan is many small releases, possibly daily. The second digit only moves for a big change (0.2.0).

       NEVER pad with leading zeros ("0.1.001"). Verified by packaging: the .exe keeps the literal text
       but Velopack normalizes it to 0.1.1, so 0.1.001 and 0.1.1 would be THE SAME version to the
       updater, with no error raised. build/Pack-Playfront.ps1 refuses to package when it sees them.
       They are not needed for ordering either: 0.1.10 sorts after 0.1.9, the comparison is numeric. -->
  <PropertyGroup>
    <PlayfrontVersion>0.1.1</PlayfrontVersion>
  </PropertyGroup>

  <PropertyGroup>
    <Version>$(PlayfrontVersion)</Version>
    <Product>Playfront</Product>
    <Company>Playfront</Company>
    <Authors>Playfront</Authors>
    <Copyright>Playfront</Copyright>
  </PropertyGroup>

</Project>
