            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE7E8;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Power options" />
            </StackPanel>
        </Border>

        <!-- Selection rings for the 6 cards: each card's rectangle (445x133) inflated 8 per
             side -> 461x149, top-left corner 8 up and 8 left of its own. Integers throughout,
             on purpose (see the Border.selectionRing comment). Declared after the cards so
             they sit above them. -->
        <Border Classes="selectionRing" x:Name="SRing0" Canvas.Left="562" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="SRing1" Canvas.Left="1016" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="SRing2" Canvas.Left="562" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="SRing3" Canvas.Left="1016" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="SRing4" Canvas.Left="562" Canvas.Top="478" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="SRing5" Canvas.Left="1016" Canvas.Top="478" Width="454" Height="148" />

        <!-- ================================================================================
             "System" content: 7 cards in 4 rows (2+2+2+1). Reuses EXACTLY the same grid as
             General (columns 567/1026, rows every 146, cards 445x133), because Xbox uses the
             same layout for both categories - measured against the reference, matching within
             1-2 px. The fourth row continues the same step: 548+146=694.
             Starts hidden; the code-behind reveals it when the category is selected.
             ================================================================================ -->

        <!-- Row 1 -->
        <Border Classes="settingsCard" x:Name="SysCard0" Canvas.Left="570" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- Console outline with a gear biting into its lower right corner. This is the
                     real one: it is not in the Windows icon font, which is why it used to be an
                     approximation - it lives in the Xbox icon font, swept glyph by glyph against
                     the reference (0.90 agreement, next best 0.84). -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE9E5;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Console info" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="SysCard1" Canvas.Left="1024" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- USB stick above an internal drive. The real one, from the Xbox icon font: swept
                     glyph by glyph against the reference (0.86 agreement, next best 0.72). It used to
                     be an approximation because only the Windows icon font had been searched. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xEA0B;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Storage devices" />
            </StackPanel>
        </Border>

