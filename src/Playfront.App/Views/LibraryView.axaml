                    <TextBlock Grid.Column="0" Width="44" TextAlignment="Center" Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mcLabel" Margin="36,0,0,0" Text="Updates" />
                </Grid>
            </Border>
            <Border Classes="manageCard" Canvas.Left="525" Canvas.Top="357" Width="640" Height="108">
                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Width="44" TextAlignment="Center" Text="&#xE88E;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="White" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Classes="mcLabel" Margin="36,0,0,0" Text="Storage devices" />
