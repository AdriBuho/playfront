                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Width="44" TextAlignment="Center" Text="&#xE8AF;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="White" VerticalAlignment="Center" />
