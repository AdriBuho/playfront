<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Color de acento de Playfront: el verde de toda la app (bordes de seleccion, resaltes, halos).
         Definido aqui una sola vez y referenciado desde el resto con {StaticResource ...}, en vez
         de repetido a mano en cada sitio - antes estaba escrito literal en 8 puntos distintos, y
         cambiarlo obligaba a acordarse de todos. Cuando llegue la pantalla "My color & theme" (que
         deja elegir el color, como en Xbox), este es el punto por el que habra que entrar.

         Valor medido pixel a pixel del verde de una Xbox real ("general
         personalization.png", 2026-07-17): el nucleo del trazo de seleccion da (67,153,65) de
         forma consistente. Se confirmo que la captura no desvia los colores comprobando que sus
         zonas planas salen exactas (#201F1F, #303030, #444444), asi que el unico margen de error
         posible era el remuestreo del trazo fino - descartado al ver dos pixeles contiguos con el
         mismo R, o sea que al menos uno esta cubierto del todo por el trazo y lleva el color real.

         AccentFadedBrush es el MISMO verde con alpha 0, no "Transparent": Transparent es blanco
         con alpha 0, asi que animar una transicion entre el y el verde pasa por blanco a mitad de
         camino en vez de desvanecerse (ver comentario en Border.outer). -->
    <Application.Resources>
        <Color x:Key="AccentColor">#439941</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentFadedBrush" Color="{StaticResource AccentColor}" Opacity="0" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>