                </Grid>
            </Border>
            <Border Classes="manageCard" Canvas.Left="1193" Canvas.Top="772" Width="640" Height="108">
                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <!-- Subscriptions.svg (Microsoft.GamingApp) -->
