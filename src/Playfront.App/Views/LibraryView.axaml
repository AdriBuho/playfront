        <Border Classes="selectionRing homeRing" x:Name="LRing4" Canvas.Left="1408" Canvas.Top="371" Width="216" Height="216" />
        <Border Classes="selectionRing homeRing" x:Name="LRing5" Canvas.Left="1630" Canvas.Top="371" Width="216" Height="216" />
        <Border Classes="selectionRing homeRing" x:Name="LRing6" Canvas.Left="520"  Canvas.Top="595" Width="216" Height="216" />
        <Border Classes="selectionRing homeRing" x:Name="LRing7" Canvas.Left="742"  Canvas.Top="595" Width="216" Height="216" />
