                <TextBlock Text="Family settings" />
            </StackPanel>
        </Border>

        <!-- Row 4 -->
        <Border Classes="settingsCard" x:Name="AccCard6" Canvas.Left="570" Canvas.Top="634" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36"><Viewbox>
                    <Canvas Width="32" Height="32">
                        <!-- APPROXIMATE, and the same shortfall as System's "Access restrictions":
                             the reference draws a group with a small padlock, and the padlock is
                             not drawn here. Same figures, missing the badge. -->
                        <Path Fill="White" Data="{StaticResource IconMultiPlayer}" />
                    </Canvas>
                </Viewbox></Grid>
                <TextBlock Text="Content restrictions" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="AccCard7" Canvas.Left="1024" Canvas.Top="634" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- APPROXIMATE. The reference badge holds an X; E8F8 is the same person and badge
                     but holds a "no entry" slash. Closest real glyph rather than a traced one. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE8F8;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Remove accounts" />
            </StackPanel>
        </Border>

        <!-- Account selection rings: same rule again, card inflated 8 per side. -->
        <Border Classes="selectionRing" x:Name="AccRing0" Canvas.Left="562" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing1" Canvas.Left="1016" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing2" Canvas.Left="562" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing3" Canvas.Left="1016" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing4" Canvas.Left="562" Canvas.Top="478" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing5" Canvas.Left="1016" Canvas.Top="478" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing6" Canvas.Left="562" Canvas.Top="626" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="AccRing7" Canvas.Left="1016" Canvas.Top="626" Width="454" Height="148" />

        <!-- ================================================================================
             "Devices & connections" content: 5 cards in 3 rows (2+2+1). Same grid again -
             columns 570/1024, rows 190/338/486, cards 438x132 - measured on the capture and
             matching General, Account and System to the pixel. The last row holds only the left
             card, the same way System's fourth row holds only "Time".

             ICONS: all five are Segoe Fluent Icons glyphs. Nothing in the Xbox app's own icon set
             draws a mouse, a phone, a media remote or a robot, and the reference's drawings ARE
             these glyphs - checked one by one, not assumed. Two are marked approximate below.
             ================================================================================ -->

        <!-- Row 1 -->
        <Border Classes="settingsCard" x:Name="DevCard0" Canvas.Left="570" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- APPROXIMATE: the reference draws a controller AND a headset side by side. This
                     is the controller alone - no single glyph or icon file has the pair, and the
                     controller is the half that carries the meaning. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Controllers &amp; headsets" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="DevCard1" Canvas.Left="1024" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xEAD9;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Mouse" />
            </StackPanel>
        </Border>

        <!-- Row 2 -->
        <Border Classes="settingsCard" x:Name="DevCard2" Canvas.Left="570" Canvas.Top="338" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE8EA;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Remote features" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="DevCard3" Canvas.Left="1024" Canvas.Top="338" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE75E;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Media remote" />
            </StackPanel>
        </Border>

        <!-- Row 3: a single card, as in the reference -->
        <Border Classes="settingsCard" x:Name="DevCard4" Canvas.Left="570" Canvas.Top="486" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- robot head with its speech-bubble tail, from the Xbox icon font. The Windows
                     font has the same head WITHOUT the tail, which is what was here before. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xEA95;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Digital assistants" />
            </StackPanel>
        </Border>

        <!-- Devices selection rings: card inflated 8 per side, as everywhere else. -->
        <Border Classes="selectionRing" x:Name="DevRing0" Canvas.Left="562" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="DevRing1" Canvas.Left="1016" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="DevRing2" Canvas.Left="562" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="DevRing3" Canvas.Left="1016" Canvas.Top="330" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="DevRing4" Canvas.Left="562" Canvas.Top="478" Width="454" Height="148" />

        <!-- ================================================================================
             "Preferences" content: 5 cards in 3 rows (2+2+1), the same shape as Devices and the
             same grid as every other category - columns 570/1024, rows 190/338/486, 438x132,
             measured on the capture.
             ================================================================================ -->

        <!-- Row 1 -->
        <Border Classes="settingsCard" x:Name="PrefCard0" Canvas.Left="570" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- speech bubble with three full-width lines, from the Xbox icon font. Was
                     Chat.svg from the same app, which draws two lines of different lengths. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xEA08;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Notifications" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="PrefCard1" Canvas.Left="1024" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- bell with "zZ", from the Xbox icon font. This one is why that font is bundled
                     at all: nothing in the Xbox app's SVG set or in the Windows icon font draws
                     the bell and the zZ together, so this card sat with a plain bell until the
                     right file turned up. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE7C6;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Idle options" />
            </StackPanel>
        </Border>

