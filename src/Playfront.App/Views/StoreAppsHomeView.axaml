<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.StoreAppsHomeView"
             Width="1920" Height="1080">

    <!-- Store "Apps Home": the landing page of the Apps section.
         Every coordinate is MEASURED off a 1:1 reference capture, not eyeballed: content spans
         x 256..1807, the top block runs y 78..618 and the row of five 634..895, with a 15-16 px
         gutter throughout. Before nudging a number "because it looks off", assume it was measured.

         The page is TALLER than the screen, so it lives in a ScrollViewer: on the console the rows
         below the fold are reached by scrolling. It is not gamepad-navigable yet, but the wheel and
         the keyboard work, which the shell's rules require of every screen.

         Artwork: promotional store material has no "original file" to go to - the 1:1 capture IS the
         source, and it is drawn at exactly the size it was captured at, so nothing is upscaled. -->

    <!-- Transparent, and the page paints only from x=228 rightwards: unlike a category page, this one
         KEEPS the store's rail (avatar, search, bag, apps...) visible down the left, exactly as the
         reference shows. The rail is the real one, showing through from the Store underneath, rather
         than a second copy that would have to be kept in step with it. -->
    <ScrollViewer x:Name="Scroll" Width="1920" Height="1080"
                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Hidden"
                  Background="Transparent">
        <Canvas x:Name="Sheet" Width="1920" Height="1960">

            <!-- The rail is 224 wide: measured on a scanline clear of icons (y=1000), where it runs
                 0..223 before the page colour starts. Content then begins at 256, so the gap is 32. -->
            <Rectangle Canvas.Left="224" Canvas.Top="0" Width="1696" Height="1960" Fill="#172B28" />

            <!-- ===== Top block: hero on the left, two stacked cards on the right ===== -->

            <Border Canvas.Left="256" Canvas.Top="78" Width="1070" Height="541"
                    CornerRadius="4" ClipToBounds="True" Background="#000000">
                <Image Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/hero-72hours.png"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <Border Canvas.Left="1341" Canvas.Top="78" Width="467" Height="263"
                    CornerRadius="4" ClipToBounds="True" Background="#000000">
                <Image Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/card-mortal-kombat.png"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <Border Canvas.Left="1341" Canvas.Top="356" Width="467" Height="263"
                    CornerRadius="4" ClipToBounds="True" Background="#000000">
                <Image Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/card-top-entertainment.png"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <!-- ===== Row of five: search, two stacked buttons, two wide cards ===== -->

            <!-- Drawn WITHOUT the reference's green focus ring. On the console this tile happened to
                 hold the focus; copying the ring would claim a selection this page does not have. -->
            <Border Canvas.Left="256" Canvas.Top="634" Width="179" Height="262"
                    CornerRadius="4" Background="#2A2E30">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="16">
                    <!-- Search.svg drawn as a path, NOT as an Image: Image.Source cannot read SVG and
                         throws while the XAML loads, which takes the whole page down. Same glyph and
                         same technique as the store's rail. -->
                    <Viewbox Width="56" Height="56" HorizontalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <Path Fill="White" Data="M30 29C30 29.2708 29.901 29.5052 29.7031 29.7031C29.5052 29.901 29.2708 30 29 30C28.7292 30 28.4948 29.901 28.2969 29.7031L20.0312 21.4375C19.0521 22.2604 17.9583 22.8906 16.75 23.3281C15.5417 23.7656 14.2917 23.9896 13 24C11.9896 24 11.0156 23.8698 10.0781 23.6094C9.14062 23.349 8.26562 22.9792 7.45312 22.5C6.64062 22.0208 5.90104 21.4479 5.23438 20.7812C4.56771 20.1146 3.98958 19.3698 3.5 18.5469C3.01042 17.724 2.64062 16.849 2.39062 15.9219C2.14062 14.9948 2.01042 14.0208 2 13C2 11.9896 2.13021 11.0156 2.39062 10.0781C2.65104 9.14062 3.02083 8.26562 3.5 7.45312C3.97917 6.64062 4.55208 5.90104 5.21875 5.23438C5.88542 4.56771 6.63021 3.98958 7.45312 3.5C8.27604 3.01042 9.15104 2.64062 10.0781 2.39062C11.0052 2.14062 11.9792 2.01042 13 2C14.0104 2 14.9844 2.13021 15.9219 2.39062C16.8594 2.65104 17.7344 3.02083 18.5469 3.5C19.3594 3.97917 20.099 4.55208 20.7656 5.21875C21.4323 5.88542 22.0104 6.63021 22.5 7.45312C22.9896 8.27604 23.3594 9.15104 23.6094 10.0781C23.8594 11.0052 23.9896 11.9792 24 13C24 14.2812 23.7812 15.526 23.3438 16.7344C22.9062 17.9427 22.2708 19.0417 21.4375 20.0312L29.7031 28.2969C29.901 28.4948 30 28.7292 30 29ZM22 13C22 12.1771 21.8958 11.3854 21.6875 10.625C21.4792 9.86458 21.1771 9.14583 20.7812 8.46875C20.3854 7.79167 19.9115 7.18229 19.3594 6.64062C18.8073 6.09896 18.1979 5.63021 17.5312 5.23438C16.8646 4.83854 16.151 4.53646 15.3906 4.32812C14.6302 4.11979 13.8333 4.01042 13 4C11.7604 4 10.5938 4.23438 9.5 4.70312C8.40625 5.17188 7.45312 5.81771 6.64062 6.64062C5.82812 7.46354 5.1875 8.41667 4.71875 9.5C4.25 10.5833 4.01042 11.75 4 13C4 14.25 4.23438 15.4219 4.70312 16.5156C5.17188 17.6094 5.8125 18.5625 6.625 19.375C7.4375 20.1875 8.39062 20.8281 9.48438 21.2969C10.5781 21.7656 11.75 22 13 22C14.2396 22 15.4062 21.7656 16.5 21.2969C17.5938 20.8281 18.5469 20.1823 19.3594 19.3594C20.1719 18.5365 20.8125 17.5833 21.2812 16.5C21.75 15.4167 21.9896 14.25 22 13Z" />
                        </Canvas>
                    </Viewbox>
                    <TextBlock Text="SEARCH" HorizontalAlignment="Center"
                               FontFamily="{StaticResource XboxFontSemibold}" FontSize="26"
                               LetterSpacing="0.6" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Canvas.Left="448" Canvas.Top="634" Width="392" Height="123"
                    CornerRadius="4" Background="#272F36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="22" Margin="32,0,0,0">
                    <Image Width="56" Height="54"
                           Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/btn-entertainment.png" />
                    <TextBlock Text="ENTERTAINMENT APPS" VerticalAlignment="Center"
                               FontFamily="{StaticResource XboxFontSemibold}" FontSize="26"
                               LetterSpacing="0.6" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Canvas.Left="448" Canvas.Top="773" Width="392" Height="123"
                    CornerRadius="4" Background="#272F36">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Spacing="22" Margin="32,0,0,0">
                    <Image Width="56" Height="54"
                           Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/btn-gamers.png" />
                    <TextBlock Text="APPS FOR GAMERS" VerticalAlignment="Center"
                               FontFamily="{StaticResource XboxFontSemibold}" FontSize="26"
                               LetterSpacing="0.6" Foreground="White" />
                </StackPanel>
            </Border>

            <Border Canvas.Left="856" Canvas.Top="634" Width="468" Height="262"
                    CornerRadius="4" ClipToBounds="True" Background="#1B0D1D">
                <Image Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/card-best-music.png"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <Border Canvas.Left="1340" Canvas.Top="634" Width="468" Height="262"
                    CornerRadius="4" ClipToBounds="True" Background="#631E2B">
                <Image Source="avares://Playfront.App/Assets/Icons/Store/AppsHome/card-anime.png"
                       Stretch="Fill" RenderOptions.BitmapInterpolationMode="HighQuality" />
            </Border>

            <!-- ===== "Apps Spotlight": rows of app tiles, drawn AT REST =====
                 On the console the focused tile widens into a landscape card with name, rating and
                 price underneath, and the page takes that app's colour. Nothing is focused here, so
                 every row is its resting state: equal square tiles, each with a label under it.
                 The tiles themselves are built in code - see the code-behind. -->

            <Canvas x:Name="Rows" Canvas.Left="0" Canvas.Top="0" />
        </Canvas>
    </ScrollViewer>
</UserControl>
