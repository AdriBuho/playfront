                    </Canvas>
                </Viewbox></Grid>
                <TextBlock Text="Capture &amp; share" />
            </StackPanel>
        </Border>
        <Border Classes="settingsCard" x:Name="PrefCard3" Canvas.Left="1024" Canvas.Top="338" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- stopwatch: crown on top, hand pointing up. Segoe Fluent Icons E916 is the
                     reference drawing, not an approximation. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE916;" FontFamily="Segoe Fluent Icons" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Break reminder" />
            </StackPanel>
        </Border>

        <!-- Row 3: a single card, as in the reference -->
        <Border Classes="settingsCard" x:Name="PrefCard4" Canvas.Left="570" Canvas.Top="486" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- wide speech bubble holding both the lines and a small avatar, from the Xbox
                     icon font. Was Feedback.svg, which has the same two elements side by side
                     rather than one inside the other. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xEA2F;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Activity feed" />
            </StackPanel>
        </Border>

        <!-- Preferences selection rings: card inflated 8 per side, as everywhere else. -->
        <Border Classes="selectionRing" x:Name="PrefRing0" Canvas.Left="562" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="PrefRing1" Canvas.Left="1016" Canvas.Top="182" Width="454" Height="148" />
        <Border Classes="selectionRing" x:Name="PrefRing2" Canvas.Left="562" Canvas.Top="330" Width="454" Height="148" />
