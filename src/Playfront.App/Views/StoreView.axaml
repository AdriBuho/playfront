            </Canvas>
        </Viewbox>

        <!-- Games (controller, hand-drawn) -->
        <Viewbox Canvas.Left="80" Canvas.Top="301" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Classes="railStroke" Data="M11,11 C7.5,11 5.2,13 4.6,16 L2.9,22.5 C2.3,25.2 4.3,26.8 6.2,26.2 C7.5,25.8 8.3,24.6 8.9,23.3 L9.9,21 L22.1,21 L23.1,23.3 C23.7,24.6 24.5,25.8 25.8,26.2 C27.7,26.8 29.7,25.2 29.1,22.5 L27.4,16 C26.8,13 24.5,11 21,11 Z" />
                <Path Classes="railStroke" Data="M9,16 L13,16 M11,14 L11,18" />
                <Path Classes="railStroke" StrokeThickness="2.4" Data="M20.5,15.5 L20.5,15.5 M23.5,17.5 L23.5,17.5" />
                <Ellipse Canvas.Left="19.3" Canvas.Top="14.3" Width="2.4" Height="2.4" Fill="#B9BEC1" />
                <Ellipse Canvas.Left="22.3" Canvas.Top="16.3" Width="2.4" Height="2.4" Fill="#B9BEC1" />
            </Canvas>
        </Viewbox>

        <!-- Apps (2x2 grid with the top-right cell offset, hand-drawn) -->
        <Viewbox Canvas.Left="80" Canvas.Top="384" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Rectangle Classes="railStroke" Canvas.Left="6.5" Canvas.Top="7.5" Width="8.5" Height="8.5" RadiusX="1.5" RadiusY="1.5"
                           Stroke="#B9BEC1" StrokeThickness="2" />
                <Rectangle Canvas.Left="18" Canvas.Top="6" Width="8.5" Height="8.5" RadiusX="1.5" RadiusY="1.5"
                           Stroke="#B9BEC1" StrokeThickness="2" />
                <Rectangle Canvas.Left="6.5" Canvas.Top="18.5" Width="8.5" Height="8.5" RadiusX="1.5" RadiusY="1.5"
                           Stroke="#B9BEC1" StrokeThickness="2" />
                <Rectangle Canvas.Left="17" Canvas.Top="18.5" Width="8.5" Height="8.5" RadiusX="1.5" RadiusY="1.5"
                           Stroke="#B9BEC1" StrokeThickness="2" />
            </Canvas>
        </Viewbox>

        <!-- Hardware (real SVG: ConsoleSolid.svg) -->
        <Viewbox Canvas.Left="80" Canvas.Top="467" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Classes="railGlyph" Data="M24,0 C25.1045695,0 26,0.8954305 26,2 L26,30 C26,31.1045695 25.1045695,32 24,32 L12.25,32 L12.25,17 L12.2435464,16.8721948 C12.1795339,16.2418747 11.6472087,15.75 11,15.75 C10.3527913,15.75 9.8204661,16.2418747 9.75645361,16.8721948 L9.75,17 L9.75,32 L8,32 C6.8954305,32 6,31.1045695 6,30 L6,2 C6,0.8954305 6.8954305,0 8,0 L24,0 Z M11,3.75 C10.3096441,3.75 9.75,4.30964406 9.75,5 C9.75,5.69035594 10.3096441,6.25 11,6.25 C11.6903559,6.25 12.25,5.69035594 12.25,5 C12.25,4.30964406 11.6903559,3.75 11,3.75 Z" />
            </Canvas>
        </Viewbox>

        <!-- Divider -->
        <Rectangle Canvas.Left="74" Canvas.Top="530" Width="42" Height="1" Fill="#4A5052" />

        <!-- Lists (real SVG: HeartWishlist.svg; in the reference this section is called "Lists") -->
        <Viewbox Canvas.Left="80" Canvas.Top="562" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Classes="railGlyph" Data="M29,28 C29.5522847,28 30,28.4477153 30,29 C30,29.5522847 29.5522847,30 29,30 L19,30 C18.4477153,30 18,29.5522847 18,29 C18,28.4477153 18.4477153,28 19,28 L29,28 Z M8.625,2 C9.79166667,2 10.9010417,2.22395833 11.953125,2.671875 C13.0052083,3.11979167 13.9479167,3.75520833 14.78125,4.578125 C14.9201389,4.71701389 15.0543981,4.85358796 15.1840278,4.98784722 L15.375,5.1875 C15.5625,5.38541667 15.765625,5.58854167 15.984375,5.796875 L16.5625,5.1875 C16.75,4.98958333 16.953125,4.79166667 17.171875,4.59375 C17.984375,3.78125 18.9166667,3.15625 19.96875,2.71875 C21.0208333,2.28125 22.125,2.05729167 23.28125,2.046875 C24.4895833,2.046875 25.625,2.27604167 26.6875,2.734375 C27.75,3.19270833 28.671875,3.82291667 29.453125,4.625 C30.234375,5.42708333 30.8541667,6.359375 31.3125,7.421875 C31.7708333,8.484375 32,9.61979167 32,10.828125 C32,11.9739583 31.7864583,13.0833333 31.359375,14.15625 C30.9322917,15.2291667 30.3072917,16.1770833 29.484375,17 L28.494,18 L25.677,18 L28.0625,15.59375 C28.6875,14.9583333 29.1666667,14.2291667 29.5,13.40625 C29.8333333,12.5833333 30,11.7239583 30,10.828125 C30,9.90104167 29.828125,9.02604167 29.484375,8.203125 C29.140625,7.38020833 28.6614583,6.66145833 28.046875,6.046875 C27.4322917,5.43229167 26.71875,4.94791667 25.90625,4.59375 C25.09375,4.23958333 24.21875,4.05729167 23.28125,4.046875 C22.3958333,4.046875 21.5520833,4.21354167 20.75,4.546875 C19.9479167,4.88020833 19.2291667,5.36458333 18.59375,6 C18.3958333,6.19791667 18.203125,6.40104167 18.015625,6.609375 C17.890625,6.74826389 17.7586806,6.88252315 17.6197917,7.01215278 L17.40625,7.203125 C17.1979167,7.40104167 16.984375,7.546875 16.765625,7.640625 C16.546875,7.734375 16.2864583,7.78125 15.984375,7.78125 C15.703125,7.78125 15.4479167,7.734375 15.21875,7.640625 C14.9895833,7.546875 14.7708333,7.40104167 14.5625,7.203125 C14.3541667,7.00520833 14.15625,6.80729167 13.96875,6.609375 L13.7760417,6.40798611 L13.359375,5.984375 C12.7135417,5.348958