        <!-- Icono de la fila CLOSE (abajo): es el glifo del boton VIEW del mando (aro con dos
             rectangulos solapados). SVG REAL de la app de Xbox instalada (@gaming/xds-foundation/svg/
             ButtonView2.svg), inlineado como Path igual que el resto de iconos del rail. Antes habia
             uno dibujado a mano (aro + flecha de "salir") que no era este. -->
        <Viewbox Canvas.Left="78" Canvas.Top="1000" Width="26" Height="26">
            <Canvas Width="32" Height="32">
                <Path Fill="#8A9092" Data="M10 12H18C18 10.8954 17.1046 10 16 10H10C8.89543 10 8 10.8954 8 12V16C8 17.1046 8.89543 18 10 18H12V16H10V12Z" />
                <!-- "F0" = regla de relleno par-impar (el SVG lleva fill-rule="evenodd"): es lo que
                     hace que el rectangulo y el aro queden HUECOS por dentro. En Avalonia va dentro
                     del propio dato del trazado, no como propiedad del Path. -->
                <Path Fill="#8A9092" Data="F0 M16 14C14.8954 14 14 14.8954 14 16V20C14 21.1046 14.8954 22 16 22H22C23.1046 22 24 21.1046 24 20V16C24 14.8954 23.1046 14 22 14H16ZM22 16H16V20H22V16Z" />
                <Path Fill="#8A9092" Data="F0 M32 16C32 24.8366 24.8366 32 16 32C7.16344 32 0 24.8366 0 16C0 7.16344 7.16344 0 16 0C24.8366 0 32 7.16344 32 16ZM30 16C30 23.732 23.732 30 16 30C8.26801 30 2 23.732 2 16C2 8.26801 8.26801 2 16 2C23.732 2 30 8.26801 30 16Z" />
            </Canvas>
        </Viewbox>
        <TextBlock Canvas.Left="116" Canvas.Top="1006" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#8A9092" />

        <!-- ============================================================
             CONTENIDO (Store Home). Geometria medida de las capturas y normalizada al lienzo
             1920x1080. FASE 3: estructura + texto (placeholders oscuros donde iran las imagenes
             reales, que se hornean despues cropeando de la captura). La navegacion se cablea aparte.
             Columnas: contenido de x=255 a x=1810.
             ============================================================ -->

        <!-- ===== Banda HERO (spotlight, carrusel) + 2 tarjetas a la derecha ===== -->

        <!-- Hero grande (izquierda) -->
        <Border Classes="storeTile" x:Name="HeroTile" Canvas.Left="240" Canvas.Top="42" Width="1098" Height="553">
            <Grid ClipToBounds="True">
                <!-- Filmstrip: las 5 paginas en HORIZONTAL, una al lado de otra. Se DESLIZA con
                     translateX animado = efecto carrusel tipo movil. El contenido de cada pagina
                     (color plano + titulo + subtitulo) lo genera el code-behind (BuildHeroPages);
                     UpdateHero mueve el filmstrip a -pagina*1098px y la transicion lo desliza hacia
                     el lado del cambio. Colores planos de placeholder por ahora (luego, artworks). -->
                <StackPanel x:Name="HeroFilmstrip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30" Easing="CubicEaseOut" />
                        </Transitions>
                    </StackPanel.Transitions>
                </StackPanel>
                <!-- Paginador FIJO (no se desliza): LB + 5 puntos + RB, centrado abajo. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,24" Spacing="0">
                    <Border Width="26" Height="18" CornerRadius="4" Background="#66000000" Margin="0,0,14,0">
                        <TextBlock Text="LB" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="HeroDot0" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot1" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot2" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot3" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot4" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Border Width="26" Height="18" CornerRadius="4" Background="#66000000" Margin="14,0,0,0">
                        <TextBlock Text="RB" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Border Classes="selectionRing" x:Name="HeroRing" Canvas.Left="232" Canvas.Top="34" Width="1114" Height="569" CornerRadius="10" />

