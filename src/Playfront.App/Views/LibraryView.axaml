        <Border Canvas.Left="527" Canvas.Top="986" Width="433" Height="60" Background="#363636" CornerRadius="6">
            <TextBlock Text="SEE FULL LIBRARY" Foreground="White" FontSize="21" VerticalAlignment="Center" Margin="28,0,0,0" />
        </Border>
        </Canvas><!-- end LGamesContent -->

        <!-- MANAGE content (traced from the reference). Hidden by default; the code-behind shows it
             when the active category is "Manage". Two card groups: actions on top + "Settings" below
             (some with an "On" state). Cards 640x108, 2 columns (x525 / x1193), vertical step 147.
             NOTE: several icons are PLACEHOLDERS (system glyphs) - the ones in the reference are
             console compositions to be recreated in a separate pass. Already real: Download
             (In queue) and Subscriptions. -->
        <Canvas x:Name="LManageContent" Width="1920" Height="1080" IsVisible="False">
            <!-- Group 1: actions -->
            <Border Classes="manageCard" Canvas.Left="525" Canvas.Top="210" Width="640" Height="108">
                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
