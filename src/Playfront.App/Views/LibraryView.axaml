<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pf="clr-namespace:Playfront.App"
             x:Class="Playfront.App.Views.LibraryView"
             Width="1920" Height="1080">
    <!-- "My games & apps" screen (library), traced 1:1 from the reference capture of a real Xbox.
         Same structure as the other views: fixed 1920x1080 canvas, built ON DEMAND when the library
         opens (MainWindow.EnterLibrary) and released on exit (ExitLibrary). For now it is VISUAL
         ONLY (not functional): B returns home, and there is no inner navigation or real data yet.

         Text is in ENGLISH per project convention even though the reference capture is in Spanish:
         layout and colours are 1:1, only the language differs. The only Spanish strings in the
         capture ("Proximamente" -> "Coming soon", "Pedir por adelantado" -> "Pre-order") are covered
         with a dark band + English text over the cover art; "X|S", "GAME PASS" and "Demo" are
         language-neutral and left exactly as the art has them.

         The 10 covers (Assets/Library/*.png) are PLACEHOLDERS cropped from the capture itself: for
         these particular games (several fictional/unreleased: Forza Horizon 6, Gears E-Day,
         GTA VI...) the capture is the only source of the exact art. Once the library is functional,
         art will come from each platform's real provider. -->
    <UserControl.Styles>
        <!-- Label of each side-menu category -->
        <Style Selector="TextBlock.menuLabel">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Icon of each category. These are the console's OWN glyphs, out of XboxFluent2, which
             ships with the app - not hand-traced shapes. Drawn as text rather than as images on
             purpose: the whole screen is scaled by a Viewbox, so a 26 px bitmap would go soft on a
             1440p or 4K panel, and a text rasterizer also fattens thin stems at small sizes exactly
             the way the console's does.
             32 is the size at which the six inked the same as the console's, measured one by one. -->
        <Style Selector="TextBlock.menuIcon">
            <Setter Property="FontFamily" Value="{StaticResource XboxIconFont}" />
            <Setter Property="FontSize" Value="26.2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <!-- The glyphs carry a left side bearing, so the ink landed on 75 instead of 80. -->
            <Setter Property="Margin" Value="4.5,0,0,0" />
        </Style>
        <!-- Grey count to the right of a category (10 / 29 / 5) -->
        <Style Selector="TextBlock.menuCount">
            <Setter Property="Foreground" Value="#9A9A9A" />
            <!-- 24.75: the digits measured 16 tall against the console's 18. -->
            <Setter Property="FontSize" Value="24.75" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
        <!-- Game name label: shown ONLY on the focused tile (the code-behind turns it on), over the
             grey tile, at the bottom. Black band at 70%, same as the home tiles. -->
        <Style Selector="Border.gameLabel">
            <Setter Property="Background" Value="#B3000000" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="14,11" />
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Border.gameLabel TextBlock">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="LineHeight" Value="24" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- Cards of the "Manage" screen (same family as the Settings ones: grey, barely rounded
             corners). Icon + label + optional state on the right ("On"). -->
        <Style Selector="Border.manageCard">
            <Setter Property="Background" Value="#333333" />
            <Setter Property="CornerRadius" Value="4" />
        </Style>
        <Style Selector="Border.manageCard TextBlock.mcLabel">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="LineHeight" Value="30" />
        </Style>
        <Style Selector="Border.manageCard TextBlock.mcState">
            <Setter Property="Foreground" Value="#B4B4B4" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
        </Style>
    </UserControl.Styles>

    <Canvas Width="1920" Height="1080">
        <!-- Background, same for sidebar and content. Re-measured against a fresh console capture:
             32,31,31, not the 39,38,38 that was here. The console's white was verified at 255 in the
             same capture, so this is a real difference and not the stream sitting at a lower level. -->
        <Rectangle Width="1920" Height="1080" Fill="#202020" />

        <!-- Thin vertical divider between the side menu and the content. Sits BEHIND the accent
             highlight so that its glow covers the divider as it passes the selected row.
             x=443 and luminance ~79: the capture peaks at 69 because a 1 px line gets smeared by the
             video codec, so the value comes from the ink integral across it, not from the peak. -->
        <Rectangle Canvas.Left="443" Canvas.Top="0" Width="1" Height="1080" Fill="#4F4F4F" />

        <!-- ===================== SIDEBAR ===================== -->

        <!-- Avatar + user name. The real Windows account name (Environment.UserName), not the one in
             the capture, same as Home/Settings. Left-aligned with the menu text (x=137). -->
        <!-- Avatar 56 across at (75,78) and the name starting at 142, all measured. The gap is 11
             and not the 24 that was here: the avatar grew and the name did not move. -->
        <StackPanel Canvas.Left="75" Canvas.Top="78" Orientation="Horizontal" Spacing="11">
            <Border Width="56" Height="56" CornerRadius="28" ClipToBounds="True" VerticalAlignment="Center">
                <Image Source="/Assets/Icons/avatar.png" Stretch="UniformToFill" />
            </Border>
            <TextBlock x:Name="LibraryUserName" Foreground="#ACACAC" FontSize="24.5" VerticalAlignment="Center" Margin="0,3,0,0" />
        </StackPanel>

        <!-- SOLID highlight of the focused category (while focus is on the MENU). Follows the THEME
             accent, like Settings. Sits BEHIND the row content. The code-behind moves it to the
             focused category (translateY) and HIDES it when focus enters the grid. -->
        <!-- 448x66 at y=186, measured. It was 443x70 at 181, so it was too tall and started too
             high; the rows themselves do not move, only this band. -->
        <Border x:Name="LMenuHighlight" Canvas.Left="0" Canvas.Top="186" Width="448" Height="66" CornerRadius="0,4,4,0"
                Background="{DynamicResource AccentBrush}" BoxShadow="{DynamicResource SettingsHighlightShadow}">
            <Border.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" Easing="QuadraticEaseInOut" />
                </Transitions>
            </Border.Transitions>
        </Border>

        <!-- OPEN category indicator: takes over from the highlight when focus enters the grid (same
             pattern as Settings). Faint grey band + thin accent bar against the right edge (next to
             the divider). Fixed on "Games", the only category with content. Hidden by default; the
             code-behind shows it when entering the grid. -->
        <Border x:Name="LCategoryIndicator" Canvas.Left="0" Canvas.Top="186" Width="448" Height="66" Background="#303030" IsVisible="False">
            <Rectangle Width="4" Height="66" Fill="{DynamicResource AccentBrush}" HorizontalAlignment="Right" />
        </Border>

        <!-- == Categories (icon | label | count) == -->

        <!-- Games (selected) -->
        <Border Canvas.Left="0" Canvas.Top="181" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <!-- Controller: HOLLOW silhouette (outline), traced from the reference. The system
                     glyph (Segoe Fluent E7FC) shows the d-pad and buttons inside; the reference is
                     outline only, so it is stroked by hand. -->
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xE9CD;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Games" Margin="16,0,0,0" />
                <TextBlock x:Name="LCount0" Grid.Column="2" Classes="menuCount" Text="10" />
            </Grid>
        </Border>

        <!-- Apps -->
        <Border Canvas.Left="0" Canvas.Top="255" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xE773;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Apps" Margin="16,0,0,0" />
                <TextBlock x:Name="LCount1" Grid.Column="2" Classes="menuCount" Text="29" />
            </Grid>
        </Border>

        <!-- Groups -->
        <Border Canvas.Left="0" Canvas.Top="328" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xE7F8;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Groups" Margin="16,0,0,0" />
                <TextBlock x:Name="LCount2" Grid.Column="2" Classes="menuCount" Text="5" />
            </Grid>
        </Border>

        <!-- Game history -->
        <Border Canvas.Left="0" Canvas.Top="402" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xEA18;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Play history" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Full library -->
        <Border Canvas.Left="0" Canvas.Top="475" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <!-- Books: outline (hollow), like the reference. On the Home the same icon is solid
                     (nav-home.png); here it is stroked to match the library capture. Three spines,
                     the third one tilted. -->
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xEA88;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Full library" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- Divider -->
        <Rectangle Canvas.Left="35" Canvas.Top="561" Width="375" Height="1" Fill="#3A3A3A" />

        <!-- Manage -->
        <Border Canvas.Left="0" Canvas.Top="592" Width="443" Height="70">
            <Grid Margin="75,0,46,0" ColumnDefinitions="46,*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Classes="menuIcon" Text="&#xE88C;" />
                <TextBlock Grid.Column="1" Classes="menuLabel" Text="Manage" Margin="16,0,0,0" />
            </Grid>
        </Border>

        <!-- == Storage meter (bottom left) == -->
        <!-- TWO lines, not three: the console reads "All storage" / "64.0 GB free". The old wording
             ("Total / {size} / available") wrapped onto a third line and pushed the whole block down.
             Measured: first line's cap top at 946, second at 981, so the pitch is 35. -->
        <StackPanel Canvas.Left="75" Canvas.Top="940" Spacing="4">
            <TextBlock Text="All storage" Foreground="White" FontSize="26" />
            <!-- Second line is dimmer than the first: measured 234 against 255 in the same capture,
                 so it is a real difference and not the codec clipping. -->
            <TextBlock x:Name="LStorageSize" Text="—" Foreground="#EAEAEA" FontSize="26" />
        </StackPanel>
        <!-- Storage ring. Re-measured against the console and it came out quite different from what
             was here: 96 across (was 85), centred on (327,968) (was (330,993)), stroke 4 (was 5),
             and NO glow - the old glow was what made the stroke read 8 px wide instead of 4.
             The track for the unfilled part is NEUTRAL grey, not a dark tint of the accent: it
             measures 40,40,40 on a console whose accent is green, so it does not follow the accent.
             The arc itself and the percentage do follow the theme. -->
        <Ellipse Canvas.Left="279" Canvas.Top="920" Width="96" Height="96"
                 Stroke="#282828" StrokeThickness="4" />
        <Path x:Name="LStorageArc" Stroke="{DynamicResource AccentBrush}" StrokeThickness="4" StrokeLineCap="Round"
              Data="M327,922 A46,46 0 1 1 306.1,926.9" />
        <TextBlock x:Name="LStoragePercent" Canvas.Left="279" Canvas.Top="955" Width="96" TextAlignment="Center"
                   Text="—" Foreground="White" FontSize="25" />

        <!-- ===================== CONTENT (RIGHT) ===================== -->

        <!-- SHARED title: the code-behind swaps it to the active category name (Games / Manage /
             ...). Moving through the menu switches the content below to the highlighted category. -->
        <!-- Entry animation of the right-hand side when the category changes. Recorded off the
             console at 60-70 frames per second and measured frame by frame:
               - the OLD content does not animate out, it just goes;
               - the NEW one appears offset ~80 px IN THE DIRECTION OF TRAVEL (down in the menu ->
                 it comes from below and rises) and almost transparent;
               - it slides into place while fading in, very fast and heavily damped: about 90% of
                 the travel in the first 80-100 ms, then it settles.
             Hence CubicEaseOut and not a linear one - linear reads as sluggish next to it.
             The transitions live here and the code-behind SUSPENDS them to set the starting state,
             otherwise the jump to the offset would animate too and it would look like a bounce. -->
        <!-- 43.5 and NOT semibold. Measured against the console: its cap height is 33 against our
             41, and its ink density over the same box is 0.32 against our 0.42 - so it was both too
             big and too heavy. Density is what settles the weight; size alone cannot. -->
        <Canvas x:Name="LContentAnim" Width="1920" Height="1080">
            <!-- Durations come straight off the frame-by-frame measurement: the slide is visually
                 settled 770 ms after the press, the fade a bit earlier. Both use the console's
                 exponential deceleration - see ConsoleSettleEasing for the numbers and for why the
                 built-in easings land too early. -->
            <Canvas.Transitions>
                <Transitions>
                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.79">
                        <TransformOperationsTransition.Easing>
                            <pf:ConsoleSettleEasing />
                        </TransformOperationsTransition.Easing>
                    </TransformOperationsTransition>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.6">
                        <DoubleTransition.Easing>
                            <pf:ConsoleSettleEasing />
                        </DoubleTransition.Easing>
                    </DoubleTransition>
                </Transitions>
            </Canvas.Transitions>
        <TextBlock x:Name="LContentTitle" Canvas.Left="522.5" Canvas.Top="73" Text="Games" Foreground="White" FontSize="43.5" />

        <!-- GAMES content: shown when the active category is Games. Wrapped in a Canvas so it can be
             shown/hidden as one block (Canvas.Left/Top coordinates stay absolute, the Canvas itself
             sits at 0,0). -->
        <Canvas x:Name="LGamesContent" Width="1920" Height="1080">

        <!-- Shown when the active category has nothing in it. An empty grid with no explanation
             reads as broken; this says why it is empty and where to fix it. -->
        <TextBlock x:Name="LEmptyText" Canvas.Left="523" Canvas.Top="310" Width="900"
                   Foreground="#9A9A9A" FontSize="26" TextWrapping="Wrap" IsVisible="False" />

        <!-- Sort dropdown. Measured: pill at (524,187), 400x64, fill 48,48,48. The label reads
             "Sort A-Z" on the console, not the truncated "Group by content t..." that was here. -->
        <Border Canvas.Left="524" Canvas.Top="187" Width="400" Height="64" Background="#303030" CornerRadius="6">
            <Grid Margin="22,0,27,0" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Column="0" Text="Sort A-Z" Foreground="White" FontSize="22" VerticalAlignment="Center" />
                <!-- Chevron E7D7 of the console's own icon font, not a traced path. -->
                <TextBlock Grid.Column="1" Text="&#xE7D7;" FontFamily="{StaticResource XboxIconFont}"
                           FontSize="21.6" Foreground="White" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <!-- Item count, right-aligned so its last character lands on 1611 - 23 px clear of the
             Filter pill. The console shows it and we did not have it at all. -->
        <TextBlock x:Name="LGamesCount" Canvas.Left="1363" Canvas.Top="211" Width="250" TextAlignment="Right"
                   Text="—" Foreground="White" FontSize="24" />

        <!-- "Filter" button (right). Measured: pill at (1634,187), 206x64. -->
        <Border Canvas.Left="1634" Canvas.Top="187" Width="206" Height="64" Background="#303030" CornerRadius="6">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="22,0,0,0" Spacing="14">
                <!-- Filter glyph EA5B, from the console's font. -->
                <TextBlock Text="&#xEA5B;" FontFamily="{StaticResource XboxIconFont}"
                           FontSize="26.5" Foreground="White" VerticalAlignment="Center" Margin="0,5,0,0" />
                <TextBlock Text="Filter" Foreground="White" FontSize="22" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- No section header here: with the console sorted A-Z the grid starts straight after
             the toolbar. The header belongs to the grouped view, which we do not have. -->

        <!-- == Game grid (row 1: 6 / row 2: 4). 202x202, radius 14. GREY placeholder (like the home
             tiles): the real art arrives with the functional part. Gamepad navigable (see
             LibraryView.axaml.cs): the focused game gets the laser ring + its name label. == -->
        <!-- Row 1 -->
        <Border x:Name="LTile0" Canvas.Left="523"  Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt0" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel0" Classes="gameLabel"><TextBlock x:Name="LName0" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile1" Canvas.Left="745.2"  Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt1" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel1" Classes="gameLabel"><TextBlock x:Name="LName1" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile2" Canvas.Left="967.4"  Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt2" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel2" Classes="gameLabel"><TextBlock x:Name="LName2" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile3" Canvas.Left="1189.6" Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt3" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel3" Classes="gameLabel"><TextBlock x:Name="LName3" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile4" Canvas.Left="1411.8" Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt4" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel4" Classes="gameLabel"><TextBlock x:Name="LName4" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile5" Canvas.Left="1634" Canvas.Top="302" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt5" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel5" Classes="gameLabel"><TextBlock x:Name="LName5" Text="" /></Border></Panel>
        </Border>

        <!-- Row 2 -->
        <Border x:Name="LTile6" Canvas.Left="523"  Canvas.Top="524" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt6" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel6" Classes="gameLabel"><TextBlock x:Name="LName6" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile7" Canvas.Left="745.2"  Canvas.Top="524" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt7" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel7" Classes="gameLabel"><TextBlock x:Name="LName7" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile8" Canvas.Left="967.4"  Canvas.Top="524" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt8" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel8" Classes="gameLabel"><TextBlock x:Name="LName8" Text="" /></Border></Panel>
        </Border>
        <Border x:Name="LTile9" Canvas.Left="1189.6" Canvas.Top="524" Width="207" Height="207" CornerRadius="14" Background="#2A2E36" ClipToBounds="True">
            <Panel><Image x:Name="LArt9" Stretch="UniformToFill" RenderOptions.BitmapInterpolationMode="HighQuality" /><Border x:Name="LLabel9" Classes="gameLabel"><TextBlock x:Name="LName9" Text="" /></Border></Panel>
        </Border>

        <!-- Selection rings (laser, home style), inflated by 7 over the tile and declared AFTER it so
             they render on top. The code-behind lights up the focused game's ring. -->
        <Border Classes="selectionRing homeRing" x:Name="LRing0" Canvas.Left="514"  Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing1" Canvas.Left="736.2"  Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing2" Canvas.Left="958.4"  Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing3" Canvas.Left="1180.6" Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing4" Canvas.Left="1402.8" Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing5" Canvas.Left="1625" Canvas.Top="293" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing6" Canvas.Left="514"  Canvas.Top="515" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing7" Canvas.Left="736.2"  Canvas.Top="515" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing8" Canvas.Left="958.4"  Canvas.Top="515" Width="225" Height="225" />
        <Border Classes="selectionRing homeRing" x:Name="LRing9" Canvas.Left="1180.6" Canvas.Top="515" Width="225" Height="225" />

        <!-- == Bottom elements (only partly visible in the reference) == -->
        <TextBlock Canvas.Left="523" Canvas.Top="885" Text="Looking for more?" Foreground="White" FontSize="26" />
        <!-- Button baseline (y=986+60=1046) aligned with the storage block and the right-hand pill. -->
        <Border Canvas.Left="523" Canvas.Top="930" Width="285" Height="64" Background="#303030" CornerRadius="6">
            <TextBlock Text="SEE FULL LIBRARY" Foreground="White" FontSize="21" VerticalAlignment="Center" Margin="28,0,0,0" />
        </Border>
        </Canvas><!-- end LGamesContent -->

        <!-- MANAGE content (traced from the reference). Hidden by default; the code-behind shows it
             when the active category is "Manage". Two card groups: actions on top + "Settings" below
             (some with an "On" state). Cards 640x108, 2 columns (x525 / x1193), vertical step 147.
             NOTE: several icons are PLACEHOLDERS (system glyphs) - the ones in the reference are
             console compositions to be recreated in a separate pass. Already real: Download
             (In queue) and Subscriptions. -->
        <Canvas x:Name="LManageContent" Width="1920" Height="1080" IsVisible="False">
            <!-- Group 1: actions -->
            <Border Classes="manageCard" Canvas.Left="525" Canvas.Top="210" Width="640" Height="108">
                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <Viewbox Grid.Column="0" Width="44" Height="44" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
                            <!-- Download.svg (Microsoft.GamingApp) -->
