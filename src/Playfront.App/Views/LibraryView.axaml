        <!-- "Search" (Y) button hint, bottom right. Visible while focus is on the MENU; entering the
             grid swaps it for the game actions (LGridHints). -->
        <!-- Pill baseline (y=994+52=1046) aligned with the button and the storage block. -->
        <Border x:Name="LSearchHint" Canvas.Left="1716" Canvas.Top="994" Width="134" Height="52" Background="#E60D0D0D" CornerRadius="26">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="13,0,0,0" Spacing="11">
                <Grid Width="27" Height="27" VerticalAlignment="Center">
                    <Ellipse Width="27" Height="27" Stroke="#E9C700" StrokeThickness="2" />
                    <TextBlock Text="Y" Foreground="#E9C700" FontSize="17" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Search" Foreground="White" FontSize="22" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- Focused game actions (while focus is on the GRID), as in the reference: pill with the REAL
             Xbox gamepad buttons (View + Menu, taken from the Xbox app icon set: ButtonView2.svg /
             ButtonMenu.svg). Same height and baseline as LSearchHint. Hidden by default; the
             code-behind shows it when entering the grid and hides LSearchHint. -->
        <Border x:Name="LGridHints" Canvas.Left="1430" Canvas.Top="994" Width="420" Height="52" Background="#E60D0D0D" CornerRadius="26" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
                <StackPanel Orientation="Horizontal" Spacing="11" VerticalAlignment="Center">
                    <Viewbox Width="27" Height="27" VerticalAlignment="Center">
                        <Canvas Width="32" Height="32">
