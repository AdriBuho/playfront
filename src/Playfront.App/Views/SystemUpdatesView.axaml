<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.SystemUpdatesView"
             Width="1920" Height="1080">
    <!-- "System Updates": opened with A on the "Updates" tile of Settings > System, closed with B
         (returning to that same tile). A FULL screen, not a panel inside Settings: no category
         sidebar and no header, same as "General Personalization". Mounted on demand, released on exit.

         Measured against the reference (1405x790, scale 1920/1405 = 1.3665). The list turned out to be
         the same one "General Personalization" uses (440x96, pitch 114): measuring here gives 441x98
         and pitch 114.8. That is why the pzTile style and its ring are reused — the two screens then
         line up to the pixel when moving between them. The only difference is that the list starts 8px
         lower (273 instead of 265), because the "Updates" section label sits above it.

         Colours verified against the reference: background #201F1F, tile #303030, selected #444444 —
         the same ones the rest of Settings already uses. The first tile is a new case: it is DIMMED
         (a status line, not a button), background #252525 with muted text. -->
    <Canvas Width="1920" Height="1080">
        <Rectangle Width="1920" Height="1080" Fill="#201F1F" />

        <!-- "System" bold and "Updates" regular inside a single TextBlock with two Runs, not two
             separate TextBlocks: that way the font places the space between the words and there is no
             need to measure where the second one starts. Same position and size as the Personalization
             title: measuring here gives x=112 and a cap height of 45, which is what Left=106 /
             FontSize=46 produces. -->
        <TextBlock Canvas.Left="106" Canvas.Top="59" FontSize="46" Foreground="White">
            <Run Text="System" FontWeight="Bold" />
            <Run Text="Updates" />
        </TextBlock>

        <!-- Section label, aligned with the left edge of the tile text. -->
        <TextBlock Canvas.Left="128" Canvas.Top="214" FontSize="28" Foreground="White" Text="Updates" />

        <!-- Description of the focused item. It starts level with the FIRST tile, not the selected
             one: measured, its first line begins at the same y as the top edge of "No console update
             available". Filled in by the code-behind. -->
        <TextBlock x:Name="UpdDescription" Canvas.Left="696" Canvas.Top="271" Width="450"
                   FontSize="24" LineHeight="32" TextWrapping="Wrap" Foreground="White" />

        <!-- Tile 1 is the update STATE and changes on its own. Opening the screen starts a check;
             depending on the result this tile lights up or dims:
               - dim (#252525 background, grey text): nothing to do, and focus skips it. This is the
                 case shown in the reference ("No console update available").
               - lit (normal background and text): there is something to press (download / restart).
             Text and colours come from the code-behind; the values here are only the initial state
             while the check runs. -->
        <Border Classes="pzTile" x:Name="UpdTile0" Canvas.Left="108" Canvas.Top="273" Background="#252525">
            <!-- Fixed width + Wrap: some states (offline, or app not installed) carry a sentence that
                 doesn't fit on one line, and without this it is cut mid-word. At 400 wide it breaks
                 into two lines at most, which is what fits in the 96px height. -->
            <TextBlock x:Name="UpdStatusText" Text="Checking for updates…" Foreground="#606060"
                       Width="400" TextWrapping="Wrap" HorizontalAlignment="Left" />
        </Border>

        <Border Classes="pzTile" x:Name="UpdTile1" Canvas.Left="108" Canvas.Top="387">
            <TextBlock Text="Latest console update status" />
        </Border>

        <!-- The two toggle tiles carry their checkbox against the right edge (measured: 34x34, 18px
             in). The check glyph needs Margin=0 and its own FontSize, because the
             "Border.pzTile TextBlock" style would otherwise apply the 20,8 margin meant for tile text. -->
        <Border Classes="pzTile" x:Name="UpdTile2" Canvas.Left="108" Canvas.Top="501">
            <Grid>
                <TextBlock Text="Keep my console up to date" />
                <Border Width="34" Height="34" BorderBrush="White" BorderThickness="2" CornerRadius="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- This tile wraps to two lines in the reference. The fixed width is what forces the break at
             the same place ("...up" / "to date"), measured from the capture. -->
        <Border Classes="pzTile" x:Name="UpdTile3" Canvas.Left="108" Canvas.Top="615">
            <Grid>
                <!-- HorizontalAlignment=Left is essential: once a width is set, a TextBlock inside a
                     Grid centres itself and the text would sit further right than in the other tiles. -->
                <TextBlock Text="Keep my games &amp; apps up to date" Width="320" TextWrapping="Wrap"
                           HorizontalAlignment="Left" />
                <Border Width="34" Height="34" BorderBrush="White" BorderThickness="2" CornerRadius="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="&#xE73E;" FontFamily="Segoe Fluent Icons" FontSize="22" Margin="0"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <!-- Rings: the tile (440x96) inflated by 8 on each side, as everywhere else in Settings. The
             first one has a ring because it can take focus when an update is available. -->
        <Border Classes="selectionRing" x:Name="UpdRing0" Canvas.Left="100" Canvas.Top="265" Width="456" Height="112" />
        <Border Classes="selectionRing selected" x:Name="UpdRing1" Canvas.Left="100" Canvas.Top="379" Width="456" Height="112" />
        <Border Classes="selectionRing" x:Name="UpdRing2" Canvas.Left="100" Canvas.Top="493" Width="456" Height="112" />
        <Border Classes="selectionRing" x:Name="UpdRing3" Canvas.Left="100" Canvas.Top="607" Width="456" Height="112" />
    </Canvas>
</UserControl>
