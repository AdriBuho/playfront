        <!-- Divisoria -->
        <Rectangle Canvas.Left="74" Canvas.Top="530" Width="42" Height="1" Fill="#4A5052" />

        <!-- Lists (SVG real: HeartWishlist.svg; en la captura esta seccion se llama "Lists") -->
        <Viewbox Canvas.Left="80" Canvas.Top="562" Width="30" Height="30">
