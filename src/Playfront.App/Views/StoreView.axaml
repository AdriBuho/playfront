<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.StoreView"
             Width="1920" Height="1080">
    <!-- Pantalla de la TIENDA (1:1 con la Store de Xbox Series X). Vive en su propia vista para
         cargarse BAJO DEMANDA (arquitectura de rendimiento: nada se construye antes de abrirse):
         MainWindow la crea al entrar (EnterStore) y la libera al salir (ExitStore). Los estilos y
         recursos de tema (AccentBrush, selectionRing...) viven en la ventana/app y CASCADEAN aqui.

         Se construye por fases:
           FASE 1: fondo (degradado medido).
           FASE 2 (ahora): rail estrecho izquierdo (perfil + iconos + divisoria + cuenta).
           Siguientes: contenido (hero + tarjetas + fila de juegos) y la doble barra lateral.

         El rail son iconos de linea sobre el fondo. Los iconos son los SVG REALES de la app de Xbox
         (Microsoft.GamingApp) inlineados como Path (mismo patron que ButtonX/bateria): Search, Store
         (bolsa = Home), HeartWishlist, Settings, ConsoleSolid (Hardware), GiftCard (Redeem). Los 4 que
         esa version del app no trae como archivo suelto (mando, claqueta, rejilla, carrito) se dibujan
         a mano midiendo de barra lateral 1. La seccion ACTIVA (Home) lleva barra verde + icono blanco;
         las demas en gris. La navegacion del rail + la doble barra lateral llegan en la fase siguiente. -->

    <UserControl.Styles>
        <!-- Icono de rail real de Xbox (path relleno, viewBox 0 0 32 32). Gris por defecto. -->
        <Style Selector="Path.railGlyph">
            <Setter Property="Fill" Value="#B9BEC1" />
        </Style>
        <!-- Icono de rail dibujado a mano (trazo). -->
        <Style Selector="Path.railStroke">
            <Setter Property="Stroke" Value="#B9BEC1" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Tile de contenido de la tienda. Relleno gris oscuro medido en las capturas (los tiles de
             UI vacios -SEARCH/DEALS- son ~#2F3437; el hero/tarjetas de imagen llevaran su arte
             despues). Esquinas ~6 (medido). ClipToBounds para recortar el arte/franja a las esquinas. -->
        <Style Selector="Border.storeTile">
            <Setter Property="Background" Value="#242A2D" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Tile de accion (SEARCH / REDEEM A CODE / DEALS): gris un pelin mas claro, como en la ref. -->
        <Style Selector="Border.storeAction">
            <Setter Property="Background" Value="#2E3336" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Titulo grande sobre un tile de imagen (hero / tarjetas). -->
        <Style Selector="TextBlock.storeTitle">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.storeSubtitle">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="22" />
        </Style>
        <!-- Etiqueta de un tile de accion (junto a su icono). -->
        <Style Selector="TextBlock.storeActionLabel">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Cabecera de seccion ("Games"). -->
        <Style Selector="TextBlock.storeSection">
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </UserControl.Styles>

    <Canvas Width="1920" Height="1080" ClipToBounds="True">

        <!-- ===== FONDO ===== -->
        <!-- UN SOLO degradado diagonal (sin radiales ni capas), muestreado EXACTAMENTE del fondo de
             tienda home 1 (excluyendo rail y tiles): teal oscuro arriba-izq ~(6,37,32) -> neutro
             oscuro abajo-der ~(21,20,31), con el azul subiendo un poco en la zona media. El rail
             (0..192) va tapado por su panel gris propio, asi que aqui solo importa x>192. -->
        <!-- BASE = el TONO, en horizontal: teal oscuro a la izquierda (arriba-izq medido (6,37,32))
             -> neutro a la derecha (arriba-der (28,27,32)). Uniforme en vertical. -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#082F26" />
                    <GradientStop Offset="1" Color="#1C1B20" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- 2º degradado = el BRILLO, en vertical: TRANSPARENTE arriba (deja el tono base tal cual) ->
             oscuro abajo. Compuesto en alfa oscurece la mitad inferior hacia abajo-izq (13,22,27) y
             abajo-der (21,20,31), sin tocar el borde superior. Color/alfa = compromiso que clava las 2
             esquinas de abajo (a=50%). Dos degradados suaves = sigue sin bordes de capa visibles. -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#80110A1A" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== RAIL: PANEL TEAL + SEPARADOR ===== -->
        <!-- Medido en tienda home 1: el rail (x<240) es un PANEL teal propio (rgb ~7-20,37,37), mas
             verdoso y algo mas claro que el contenido morado, y UNIFORME de arriba a abajo (no sigue
             el degradado diagonal del fondo). Aqui se pinta el panel + la LINEA vertical fina del
             borde; la SOMBRA sobre el contenido pegado al rail se pinta al final (arriba del todo,
             para que caiga SOBRE los tiles, como en la referencia). -->
        <!-- Rail: franja NEUTRA algo mas CLARA que el fondo (medido en tienda home 1: el rail ~36 de
             brillo, mas claro que el hueco/contenido ~27). Acaba en la LINEA divisoria en x=192 (NO
             en 240): en la original la linea esta ~46px a la izquierda del borde de los tiles, con un
             hueco entre medias -por eso parecia "una columna mas ancha". Del rail (0..192) a los tiles
             (240) hay un hueco (192..240) que la SOMBRA (abajo) oscurece = "sombra a la derecha de la
             linea". Se hace neutro (no teal) porque el teal se ve verde en la pantalla de la Ally. -->
        <Rectangle x:Name="RailPanel" Canvas.Left="0" Canvas.Top="0" Width="192" Height="1080" Fill="#1D2627" />
        <!-- Linea vertical divisoria (fina) al borde derecho del rail, en x=192. -->
        <Rectangle x:Name="RailDivider" Canvas.Left="192" Canvas.Top="0" Width="1.5" Height="1080" Fill="#2CFFFFFF" />

        <!-- ===== RAIL ESTRECHO (icono-centro x=95) ===== -->

        <!-- Perfil (avatar circular) arriba -->
        <Border Canvas.Left="70" Canvas.Top="38" Width="50" Height="50" CornerRadius="25" ClipToBounds="True">
            <Image Source="/Assets/Icons/avatar.png" Stretch="UniformToFill" />
        </Border>

        <!-- Barra verde de la seccion ACTIVA (Home). Vertical, a la izquierda del icono. -->
        <Rectangle x:Name="RailActiveBar" Canvas.Left="40" Canvas.Top="219" Width="4" Height="28" RadiusX="2" RadiusY="2"
                   Fill="{DynamicResource AccentBrush}" />

        <!-- Search (SVG real: Search.svg) -->
        <Viewbox Canvas.Left="80" Canvas.Top="135" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Classes="railGlyph" Data="M30 29C30 29.2708 29.901 29.5052 29.7031 29.7031C29.5052 29.901 29.2708 30 29 30C28.7292 30 28.4948 29.901 28.2969 29.7031L20.0312 21.4375C19.0521 22.2604 17.9583 22.8906 16.75 23.3281C15.5417 23.7656 14.2917 23.9896 13 24C11.9896 24 11.0156 23.8698 10.0781 23.6094C9.14062 23.349 8.26562 22.9792 7.45312 22.5C6.64062 22.0208 5.90104 21.4479 5.23438 20.7812C4.56771 20.1146 3.98958 19.3698 3.5 18.5469C3.01042 17.724 2.64062 16.849 2.39062 15.9219C2.14062 14.9948 2.01042 14.0208 2 13C2 11.9896 2.13021 11.0156 2.39062 10.0781C2.65104 9.14062 3.02083 8.26562 3.5 7.45312C3.97917 6.64062 4.55208 5.90104 5.21875 5.23438C5.88542 4.56771 6.63021 3.98958 7.45312 3.5C8.27604 3.01042 9.15104 2.64062 10.0781 2.39062C11.0052 2.14062 11.9792 2.01042 13 2C14.0104 2 14.9844 2.13021 15.9219 2.39062C16.8594 2.65104 17.7344 3.02083 18.5469 3.5C19.3594 3.97917 20.099 4.55208 20.7656 5.21875C21.4323 5.88542 22.0104 6.63021 22.5 7.45312C22.9896 8.27604 23.3594 9.15104 23.6094 10.0781C23.8594 11.0052 23.9896 11.9792 24 13C24 14.2812 23.7812 15.526 23.3438 16.7344C22.9062 17.9427 22.2708 19.0417 21.4375 20.0312L29.7031 28.2969C29.901 28.4948 30 28.7292 30 29ZM22 13C22 12.1771 21.8958 11.3854 21.6875 10.625C21.4792 9.86458 21.1771 9.14583 20.7812 8.46875C20.3854 7.79167 19.9115 7.18229 19.3594 6.64062C18.8073 6.09896 18.1979 5.63021 17.5312 5.23438C16.8646 4.83854 16.151 4.53646 15.3906 4.32812C14.6302 4.11979 13.8333 4.01042 13 4C11.7604 4 10.5938 4.23438 9.5 4.70312C8.40625 5.17188 7.45312 5.81771 6.64062 6.64062C5.82812 7.46354 5.1875 8.41667 4.71875 9.5C4.25 10.5833 4.01042 11.75 4 13C4 14.25 4.23438 15.4219 4.70312 16.5156C5.17188 17.6094 5.8125 18.5625 6.625 19.375C7.4375 20.1875 8.39062 20.8281 9.48438 21.2969C10.5781 21.7656 11.75 22 13 22C14.2396 22 15.4062 21.7656 16.5 21.2969C17.5938 20.8281 18.5469 20.1823 19.3594 19.3594C20.1719 18.5365 20.8125 17.5833 21.2812 16.5C21.75 15.4167 21.9896 14.25 22 13Z" />
            </Canvas>
        </Viewbox>

        <!-- Home (SVG real: Store.svg, la bolsa). ACTIVO: blanco. -->
