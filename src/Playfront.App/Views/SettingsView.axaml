        <!-- ================================================================================
             "Account" content: 8 cards in 4 full rows. Same grid as General and System - the
             reference uses one card grid for every category, and this screen confirms it:
             columns 570/1024, rows 190/338/486/634, cards 438x132, all measured on the capture
             and matching General to the pixel.

             ICON SOURCES. Five are the exact drawing the reference uses, taken from the original
             file rather than traced: CreditCard.svg, Subscriptions.svg and GenreFamilyFriends.svg
             from the installed Xbox app's icon set, Lock.svg via IconLock, and the chain link,
             which is not in that set but IS the same drawing as Segoe Fluent Icons E71B.
             Three are NOT the reference drawing and are marked at each card.
             ================================================================================ -->

        <!-- Row 1 -->
        <Border Classes="settingsCard" x:Name="AccCard0" Canvas.Left="570" Canvas.Top="190" Width="438" Height="132" IsVisible="False">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="31,0,0,0" Spacing="29">
                <!-- person with a round badge holding a right arrow, from the Xbox icon font.
                     Was a near-miss from the Windows font (same person and badge, but a plus
                     inside) until the real set turned up. -->
                <Grid Width="36" Height="36">
                    <TextBlock Text="&#xE936;" FontFamily="{StaticResource XboxIconFont}" FontSize="36" Foreground="White"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <TextBlock Text="Sign-in, security &amp; PIN" />
            </StackPanel>
        </Border>
