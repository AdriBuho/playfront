        <!-- CLOSE row icon (bottom): the gamepad VIEW button glyph (ring with two overlapping
             rectangles). REAL SVG from the installed Xbox app (@gaming/xds-foundation/svg/
             ButtonView2.svg), inlined as a Path like the rest of the rail icons. There used to be a
             hand-drawn one here (ring + "exit" arrow) that was not this glyph. -->
        <Viewbox Canvas.Left="78" Canvas.Top="1000" Width="26" Height="26">
            <Canvas Width="32" Height="32">
                <Path Fill="#8A9092" Data="M10 12H18C18 10.8954 17.1046 10 16 10H10C8.89543 10 8 10.8954 8 12V16C8 17.1046 8.89543 18 10 18H12V16H10V12Z" />
                <!-- "F0" = even-odd fill rule (the SVG carries fill-rule="evenodd"): it is what
                     leaves the rectangle and the ring HOLLOW inside. In Avalonia this goes inside
                     the path data itself, not as a Path property. -->
                <Path Fill="#8A9092" Data="F0 M16 14C14.8954 14 14 14.8954 14 16V20C14 21.1046 14.8954 22 16 22H22C23.1046 22 24 21.1046 24 20V16C24 14.8954 23.1046 14 22 14H16ZM22 16H16V20H22V16Z" />
                <Path Fill="#8A9092" Data="F0 M32 16C32 24.8366 24.8366 32 16 32C7.16344 32 0 24.8366 0 16C0 7.16344 7.16344 0 16 0C24.8366 0 32 7.16344 32 16ZM30 16C30 23.732 23.732 30 16 30C8.26801 30 2 23.732 2 16C2 8.26801 8.26801 2 16 2C23.732 2 30 8.26801 30 16Z" />
            </Canvas>
        </Viewbox>
        <TextBlock Canvas.Left="116" Canvas.Top="1006" Text="&#xE76C;" FontFamily="Segoe Fluent Icons" FontSize="16" Foreground="#8A9092" />

        <!-- ============================================================
             CONTENT (Store Home). Geometry measured from the references and normalised to the
             1920x1080 canvas. PHASE 3: structure + text (dark placeholders where the real images will
             go, baked later by cropping from the reference). Navigation is wired separately.
             Columns: content from x=255 to x=1810.
             ============================================================ -->

        <!-- ===== HERO band (spotlight, carousel) + 2 cards on the right ===== -->

        <!-- Large hero (left) -->
        <Border Classes="storeTile" x:Name="HeroTile" Canvas.Left="240" Canvas.Top="42" Width="1098" Height="553">
            <Grid ClipToBounds="True">
                <!-- Filmstrip: the 5 pages laid out HORIZONTALLY, side by side. It SLIDES via an
                     animated translateX = phone-style carousel effect. The code-behind generates
                     each page's content (flat colour + title + subtitle) in BuildHeroPages;
                     UpdateHero moves the filmstrip to -page*1098px and the transition slides it
                     towards the side of the change. Flat placeholder colours for now (artwork
                     later). -->
                <StackPanel x:Name="HeroFilmstrip" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top">
                    <StackPanel.Transitions>
                        <Transitions>
                            <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.30" Easing="CubicEaseOut" />
                        </Transitions>
                    </StackPanel.Transitions>
                </StackPanel>
                <!-- FIXED pager (does not slide): LB + 5 dots + RB, centred at the bottom. -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                            Margin="0,0,0,24" Spacing="0">
                    <Border Width="26" Height="18" CornerRadius="4" Background="#66000000" Margin="0,0,14,0">
                        <TextBlock Text="LB" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="HeroDot0" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot1" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot2" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot3" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Ellipse x:Name="HeroDot4" Width="8" Height="8" Fill="#7AFFFFFF" Margin="5,0" />
                    <Border Width="26" Height="18" CornerRadius="4" Background="#66000000" Margin="14,0,0,0">
                        <TextBlock Text="RB" FontSize="11" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
        <Border Classes="selectionRing" x:Name="HeroRing" Canvas.Left="232" Canvas.Top="34" Width="1114" Height="569" CornerRadius="10" />

        <!-- Top-right card: "Get ready!" (Cyberpunk) -->
        <Border Classes="storeTile" x:Name="RightTopTile" Canvas.Left="1357" Canvas.Top="42" Width="483" Height="287">
            <TextBlock Classes="storeTitle" Text="Get ready!" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,22" />
        </Border>
        <Border Classes="selectionRing" x:Name="RightTopRing" Canvas.Left="1349" Canvas.Top="34" Width="499" Height="303" CornerRadius="10" />

        <!-- Bottom-right card: "Pre-order Assassin's Creed Valhalla" -->
        <Border Classes="storeTile" x:Name="RightBotTile" Canvas.Left="1357" Canvas.Top="346" Width="483" Height="249">
            <TextBlock Classes="storeTitle" FontSize="28" TextWrapping="Wrap" TextAlignment="Center"
                       Text="Pre-order Assassin's Creed Valhalla" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24,0,24,20" />
        </Border>
        <Border Classes="selectionRing" x:Name="RightBotRing" Canvas.Left="1349" Canvas.Top="338" Width="499" Height="265" CornerRadius="10" />

        <!-- ===== ACTION row ===== -->

        <!-- SEARCH (square, default focus = accent ring) -->
        <Border Classes="storeAction" x:Name="SearchTile" Canvas.Left="240" Canvas.Top="613" Width="185" Height="268">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="14">
                <Viewbox Width="40" Height="40" HorizontalAlignment="Center">
                    <Canvas Width="32" Height="32">
                        <Path Fill="White" Data="M30 29C30 29.2708 29.901 29.5052 29.7031 29.7031C29.5052 29.901 29.2708 30 29 30C28.7292 30 28.4948 29.901 28.2969 29.7031L20.0312 21.4375C19.0521 22.2604 17.9583 22.8906 16.75 23.3281C15.5417 23.7656 14.2917 23.9896 13 24C11.9896 24 11.0156 23.8698 10.0781 23.6094C9.14062 23.349 8.26562 22.9792 7.45312 22.5C6.64062 22.0208 5.90104 21.4479 5.23438 20.7812C4.56771 20.1146 3.98958 19.3698 3.5 18.5469C3.01042 17.724 2.64062 16.849 2.39062 15.9219C2.14062 14.9948 2.01042 14.0208 2 13C2 11.9896 2.13021 11.0156 2.39062 10.0781C2.65104 9.14062 3.02083 8.26562 3.5 7.45312C3.97917 6.64062 4.55208 5.90104 5.21875 5.23438C5.88542 4.56771 6.63021 3.98958 7.45312 3.5C8.27604 3.01042 9.15104 2.64062 10.0781 2.39062C11.0052 2.14062 11.9792 2.01042 13 2C14.0104 2 14.9844 2.13021 15.9219 2.39062C16.8594 2.65104 17.7344 3.02083 18.5469 3.5C19.3594 3.97917 20.099 4.55208 20.7656 5.21875C21.4323 5.88542 22.0104 6.63021 22.5 7.45312C22.9896 8.27604 23.3594 9.15104 23.6094 10.0781C23.8594 11.0052 23.9896 11.9792 24 13C24 14.2812 23.7812 15.526 23.3438 16.7344C22.9062 17.9427 22.2708 19.0417 21.4375 20.0312L29.7031 28.2969C29.901 28.4948 30 28.7292 30 29ZM22 13C22 12.1771 21.8958 11.3854 21.6875 10.625C21.4792 9.86458 21.1771 9.14583 20.7812 8.46875C20.3854 7.79167 19.9115 7.18229 19.3594 6.64062C18.8073 6.09896 18.1979 5.63021 17.5312 5.23438C16.8646 4.83854 16.151 4.53646 15.3906 4.32812C14.6302 4.11979 13.8333 4.01042 13 4C11.7604 4 10.5938 4.23438 9.5 4.70312C8.40625 5.17188 7.45312 5.81771 6.64062 6.64062C5.82812 7.46354 5.1875 8.41667 4.71875 9.5C4.25 10.5833 4.01042 11.75 4 13C4 14.25 4.23438 15.4219 4.70312 16.5156C5.17188 17.6094 5.8125 18.5625 6.625 19.375C7.4375 20.1875 8.39062 20.8281 9.48438 21.2969C10.5781 21.7656 11.75 22 13 22C14.2396 22 15.4062 21.7656 16.5 21.2969C17.5938 20.8281 18.5469 20.1823 19.3594 19.3594C20.1719 18.5365 20.8125 17.5833 21.2812 16.5C21.75 15.4167 21.9896 14.25 22 13Z" />
                    </Canvas>
                </Viewbox>
                <TextBlock Text="SEARCH" Foreground="White" FontSize="20" HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
        <Border Classes="selectionRing" x:Name="SearchRing" Canvas.Left="232" Canvas.Top="605" Width="201" Height="284" CornerRadius="10" />

        <!-- REDEEM A CODE (top) -->
        <Border Classes="storeAction" x:Name="RedeemTile" Canvas.Left="443" Canvas.Top="613" Width="397" Height="132">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0" Spacing="22">
                <Canvas Width="34" Height="34" VerticalAlignment="Center">
                    <Rectangle Canvas.Left="4" Canvas.Top="4" Width="11" Height="11" Stroke="White" StrokeThickness="2" />
                    <Rectangle Canvas.Left="19" Canvas.Top="4" Width="11" Height="11" Stroke="White" StrokeThickness="2" />
                    <Rectangle Canvas.Left="4" Canvas.Top="19" Width="11" Height="11" Stroke="White" StrokeThickness="2" />
                    <Rectangle Canvas.Left="21" Canvas.Top="21" Width="3.5" Height="3.5" Fill="White" />
                    <Rectangle Canvas.Left="26.5" Canvas.Top="26.5" Width="3.5" Height="3.5" Fill="White" />
                </Canvas>
                <TextBlock Classes="storeActionLabel" Text="REDEEM A CODE" />
            </StackPanel>
        </Border>
        <Border Classes="selectionRing" x:Name="RedeemRing" Canvas.Left="435" Canvas.Top="605" Width="413" Height="148" CornerRadius="10" />

        <!-- DEALS (bottom) -->
        <Border Classes="storeAction" x:Name="DealsTile" Canvas.Left="443" Canvas.Top="763" Width="397" Height="118">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="30,0,0,0" Spacing="22">
                <Canvas Width="34" Height="34" VerticalAlignment="Center">
                    <Path Stroke="White" StrokeThickness="2" StrokeJoin="Round"
                          Data="M5,16 L16,5 L28,5 L28,17 L17,28 C16,29 14.5,29 13.5,28 L5,19.5 C4,18.5 4,17 5,16 Z" />
                    <Ellipse Canvas.Left="20" Canvas.Top="9" Width="5" Height="5" Stroke="White" StrokeThickness="1.6" />
                </Canvas>
                <TextBlock Classes="storeActionLabel" Text="DEALS" />
            </StackPanel>
        </Border>
        <Border Classes="selectionRing" x:Name="DealsRing" Canvas.Left="435" Canvas.Top="755" Width="413" Height="134" CornerRadius="10" />

        <!-- Card A: "Dive into the free to play world of Destiny 2" -->
        <Border Classes="storeTile" x:Name="CardATile" Canvas.Left="858" Canvas.Top="613" Width="480" Height="268">
            <Grid>
                <Rectangle VerticalAlignment="Bottom" Height="140">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#B0000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,18"
                           Text="Dive into the free to play world of Destiny 2" />
            </Grid>
        </Border>
        <Border Classes="selectionRing" x:Name="CardARing" Canvas.Left="850" Canvas.Top="605" Width="496" Height="284" CornerRadius="10" />

        <!-- Card B: "Get ready for Halo Infinite" -->
        <Border Classes="storeTile" x:Name="CardBTile" Canvas.Left="1357" Canvas.Top="613" Width="483" Height="268">
            <Grid>
                <Rectangle VerticalAlignment="Bottom" Height="140">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#B0000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,18"
                           Text="Get ready for Halo Infinite" />
            </Grid>
        </Border>
        <Border Classes="selectionRing" x:Name="CardBRing" Canvas.Left="1349" Canvas.Top="605" Width="499" Height="284" CornerRadius="10" />

        <!-- ===== "Games" section (header + placeholder cover rail) ===== -->
        <TextBlock Classes="storeSection" Canvas.Left="240" Canvas.Top="903" Text="Games" />
        <!-- Cover rail (portrait). The code-behind generates the tiles and their rings
             (BuildGamesRail) inside this Canvas so they can be made navigable. Placeholders for now;
             art is filled in later. Clipped at the bottom by the window edge. -->
        <Canvas x:Name="GamesRailHost" Canvas.Left="240" Canvas.Top="948" />

        <!-- "Shadow to the right of the line" (x=192): darkens the GAP between the rail edge (192)
             and the tiles (240), darkest against the line and fading towards the tiles, as in the
             original. Painted last (topmost). Does not capture input. -->
        <Rectangle x:Name="RailShadow" Canvas.Left="192" Canvas.Top="0" Width="48" Height="1080" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#33000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============================================================
             DOUBLE SIDEBAR (overlay layer, hidden by default).
             Measured 1:1 from the reference. Expands when moving LEFT out of the content.
             Three zones: LABEL column (0..384) + SUBCATEGORY column (389..797) + dimmed CONTENT.
             It does not cover the rail icons (x<192): the dimming starts at x=192 and the two opaque
             panels cover it up to 797, leaving the content (797..) darkened. The labels and
             subcategory tiles are built in the code-behind (dynamic positions + focus).
             ============================================================ -->
        <Canvas x:Name="SidebarHost" Width="1920" Height="1080" IsVisible="False" ClipToBounds="True">
            <!-- Content dimming: DELIBERATELY DISABLED (the Xbox reference does have it, but here the
                 content is preferred at full brightness with the sidebar open). The element is kept,
                 unused, in case it is wanted back: it would just need fading in again. -->
            <Rectangle x:Name="SidebarDim" Canvas.Left="192" Canvas.Top="0" Width="1728" Height="1080"
                       Fill="#99000000" IsHitTestVisible="False" IsVisible="False" />

            <!-- 2nd COLUMN (Col1Layer): sits BELOW the labels in z-order so that, on opening, it LOOKS
                 like it EMERGES from behind them (it slides right as it appears). Visible only when
                 the focused category has subcategories. The code-behind animates the slide and
                 opacity (AnimateIn). -->
            <Canvas x:Name="Col1Layer">
                <Canvas x:Name="SubColumn">
                    <!-- ACRYLIC BACKDROP: BLURRED snapshot of what lies underneath (the code-behind
                         takes it on opening). Clipped to the column; the image is placed at -389 so
                         it lands 1:1 over the real content it covers. Measured on the reference:
                         behind the panel there is no detail, only soft blobs = blur + tint. -->
                    <Canvas Canvas.Left="384" Canvas.Top="0" Width="413" Height="1080" ClipToBounds="True">
                        <Image x:Name="BackdropCol1" Canvas.Left="-384" Canvas.Top="0" Width="1920" Height="1080" />
                    </Canvas>
                    <!-- SUBCATEGORY column: translucent TINT (384..797). Measured: same tone as the
                         labels but ~10 points lighter. Starts at 384 (exactly where the label column
                         ends) so no sliver of sharp content shows between the two. The clean
                         reference has NO divider line and no shadow: the separation between columns
                         is only the change of tone. -->
                    <Rectangle Canvas.Left="384" Canvas.Top="0" Width="413" Height="1080" Fill="#C72B3133" />
                </Canvas>
                <!-- Subcategory tiles (built in the code-behind). -->
                <Canvas x:Name="SidebarSubHost" />
            </Canvas>

            <!-- LABEL COLUMN (Col0Layer): ABOVE the 2nd column. Slides and fades on opening,
                 appearing outwards from the rail icons. -->
            <Canvas x:Name="Col0Layer">
                <!-- ACRYLIC BACKDROP of this column (same blurred snapshot, clipped to 192..384). -->
                <Canvas Canvas.Left="192" Canvas.Top="0" Width="192" Height="1080" ClipToBounds="True">
                    <Image x:Name="BackdropCol0" Canvas.Left="-192" Canvas.Top="0" Width="1920" Height="1080" />
                </Canvas>
                <!-- Rail panel extension (192..384): translucent TINT measured (30,41,41) at ~70%. -->
                <Rectangle Canvas.Left="192" Canvas.Top="0" Width="192" Height="1080" Fill="#C71E2929" />
                <!-- ACTIVE bar (follows the theme colour). The code-behind places it on the focused row. -->
                <Rectangle x:Name="SidebarActiveBar" Canvas.Left="40" Canvas.Top="302" Width="4" Height="28"
                           RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" />
                <!-- Profile name (next to the avatar), visible only when expanded. -->
                <!-- The code-behind fills the text with the Windows account (Environment.UserName).
                     It used to be the reference capture's name, hardcoded. -->
                <TextBlock x:Name="SidebarProfileName" Canvas.Left="140" Canvas.Top="49" Text=""
                           FontSize="24" FontWeight="SemiBold" Foreground="White" />
                <!-- Labels (built in the code-behind). -->
                <Canvas x:Name="SidebarLabelHost" />
            </Canvas>
        </Canvas>

    </Canvas>
</UserControl>
