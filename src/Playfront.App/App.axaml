<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <!-- Accent colour: everything that marks selection (borders, rings, glows, highlights).
         These are only the fallbacks. AccentTheme.Apply overwrites all three at startup with the
         saved accent, which is why the rest of the XAML reads them through DynamicResource.

         #439941 is the green measured pixel by pixel off a real Xbox: the core of the selection
         stroke reads (67,153,65) consistently. The flat areas of that same capture came out exact
         (#201F1F, #303030, #444444), so the capture is not shifting colours.

         AccentFadedBrush is the SAME colour with alpha 0, NOT "Transparent": Transparent is white
         with alpha 0, so animating between the two passes through white halfway instead of fading
         out (see the comment on Border.outer). -->
    <Application.Resources>
        <Color x:Key="AccentColor">#439941</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
        <SolidColorBrush x:Key="AccentFadedBrush" Color="{StaticResource AccentColor}" Opacity="0" />

        <!-- The reference UI's own typeface, not Segoe UI. It ships as a font file inside the
             installed Xbox app (Microsoft.GamingApp\Assets\Fonts), the same place the icons came
             from, and the file is bundled here so it works on machines without that app.

             It is NOT interchangeable with Segoe UI even though the two are metrically close:
             across the thirteen labels of the Settings screen both land within ~1 px, but at
             heading sizes the letterforms and the spacing diverge visibly. Anything meant to look
             like the reference uses this; the icon glyphs keep using Segoe Fluent Icons.

             Referenced as a resource rather than repeating the avares:// string: the "#Segoe Sans
             Text" suffix after the file path is the family name inside the .ttf and is required -
             without it the font silently falls back to the default and nothing reports an error.
             The suffix must be the family name the file actually declares, which is not always the
             filename: Segoe-Sans-Text-Semibold.ttf declares "Segoe Sans Text Semibold" as a family
             of its own, not a Semibold weight of "Segoe Sans Text". Setting FontWeight instead of
             using these families gets a synthesised fake bold.

             THREE cuts, and which one goes where is measured, not guessed. Matching a candidate
             against the reference by ink width alone cannot tell weights apart (in this family
             Regular at 26 and Semibold at 25 produce the same widths). Overlaying the glyph shapes
             - both blurred equally, since the reference is compressed video - does: across the
             title and the body labels the Semibold cuts win by a wide margin and Light comes last.
             The reference UI is Semibold, not Regular. -->
        <FontFamily x:Key="XboxFontFamily">avares://Playfront.App/Assets/Fonts/Segoe-Sans-Text.ttf#Segoe Sans Text</FontFamily>
        <FontFamily x:Key="XboxFontSemibold">avares://Playfront.App/Assets/Fonts/Segoe-Sans-Text-Semibold.ttf#Segoe Sans Text Semibold</FontFamily>
        <!-- Display cut, for headings only. Optical size: Display is drawn for large type, Text for
             body. Using Text large (or Display small) is what makes a heading look almost-right. -->
        <FontFamily x:Key="XboxFontDisplaySemibold">avares://Playfront.App/Assets/Fonts/Segoe-Sans-Display-Semibold.ttf#Segoe Sans Display Semibold</FontFamily>

        <!-- The reference UI's ICON set, which is NOT Segoe Fluent Icons. It also ships inside the
             installed Xbox app. Segoe Fluent has near-misses for a lot of these - a bell without
             the "zZ", a robot without its speech tail, a person whose badge holds a plus instead of
             an arrow - and every one of those was a card that could not be finished until this file
             turned up. Where a drawing exists here, it is the drawing, not an approximation.

             Finding it took a detour worth writing down: the file lives under a path with spaces,
             and the browser used to render the glyph sheets silently refuses to load a @font-face
             from such a URL - every glyph came out as the empty-box "missing glyph" and the font
             looked like it had no letters at all. Copy it somewhere without spaces first.
             To list what a font actually defines, do not guess codepoint ranges: read
             System.Windows.Media.GlyphTypeface(...).CharacterToGlyphMap. -->
        <FontFamily x:Key="XboxIconFont">avares://Playfront.App/Assets/Fonts/XboxFluent2.ttf#Xbox Fluent v2</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- THE ON/OFF CHECKBOX, defined ONCE for the whole app.
             It used to be copied into every screen that needed one, and the copies drifted: the tick
             ended up 8 px from the left edge of its box and 3 from the right, visibly off-centre,
             everywhere. Anything that needs a checkbox uses these two classes and nothing else.

             Measured on the console, 1:1. Box 32x32 with a 2 px stroke. The tick's centre line runs
             (7,14.9) -> (13,20.9) -> (24.9,9) inside that box, so BOTH ARMS ARE AT EXACTLY 45 degrees
             - that is the property to preserve if this is ever redrawn.

             The Path is placed at (7,9) inside the box, which is why the data starts at (0,5.9). With
             a 2.1 stroke and round caps that paints x 6..25 and y 8..21 of the box: 6 px clear on the
             left and 6 on the right (centred), 8 above and 10 below (sitting slightly high). Those
             four numbers are the check - they were measured off the console and they match.

             The fractions are load-bearing, not sloppiness. Round numbers put the stroke's edge
             exactly on a pixel boundary, where it lights the pixel by 5% and effectively disappears:
             that cost the tick a pixel of length and made it look shifted. -->
        <Style Selector="Border.checkBox">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="BorderBrush" Value="White" />
            <Setter Property="BorderThickness" Value="2" />
            <Setter Property="CornerRadius" Value="2" />
        </Style>
        <!-- Explanatory paragraph on a Settings sub-screen. Size 26 and a 34.5 line pitch are the same
             on every screen measured so far, so they live here; the WIDTH is not, because it is what
             decides where each screen's text wraps, and each screen sets its own. -->
        <Style Selector="TextBlock.settingsDesc">
            <Setter Property="FontFamily" Value="{StaticResource XboxFontFamily}" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="LineHeight" Value="34.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Path.checkTick">
            <Setter Property="Stroke" Value="White" />
            <Setter Property="StrokeThickness" Value="2.1" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Data" Value="M0,5.9 L6,11.9 L17.9,0" />
        </Style>
    </Application.Styles>
</Application>