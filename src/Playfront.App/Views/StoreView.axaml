            <Grid>
                <Rectangle VerticalAlignment="Bottom" Height="140">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                            <GradientStop Offset="0" Color="#00000000" />
                            <GradientStop Offset="1" Color="#B0000000" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <TextBlock FontSize="24" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="40,0,40,18"
                           Text="Get ready for Halo Infinite" />
            </Grid>
        </Border>
        <Border Classes="selectionRing" x:Name="CardBRing" Canvas.Left="1349" Canvas.Top="605" Width="499" Height="284" CornerRadius="10" />

        <!-- ===== Seccion "Games" (cabecera + rail de caratulas placeholder) ===== -->
        <TextBlock Classes="storeSection" Canvas.Left="240" Canvas.Top="903" Text="Games" />
        <!-- Rail de caratulas (portrait). Las casillas + sus anillos se generan por code-behind
             (BuildGamesRail) dentro de este Canvas, para poder hacerlas navegables. Placeholders por
             ahora; se pueblan con arte luego. Recortado abajo por el borde de la ventana. -->
        <Canvas x:Name="GamesRailHost" Canvas.Left="240" Canvas.Top="948" />

        <!-- Sombra "a la derecha de la linea" (x=192): oscurece el HUECO entre el borde del rail
             (192) y los tiles (240), mas oscuro pegado a la linea y difuminando hacia los tiles,
             como en la original. Se pinta al final (arriba del todo). No captura input. -->
        <Rectangle x:Name="RailShadow" Canvas.Left="192" Canvas.Top="0" Width="48" Height="1080" IsHitTestVisible="False">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#33000000" />
                    <GradientStop Offset="1" Color="#00000000" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ============================================================
             DOBLE BARRA LATERAL (capa superpuesta, oculta por defecto).
             Medida 1:1 de "barra lateral 1". Se despliega al ir a la IZQUIERDA desde el contenido.
             Tres zonas: col.ETIQUETAS (0..384) + col.SUBCATEGORIAS (389..797) + CONTENIDO atenuado.
             No tapa los iconos del rail (x<192): la atenuacion arranca en x=192 y los dos paneles
             opacos la cubren hasta 797, dejando el contenido (797..) oscurecido. Las etiquetas y los
             tiles de subcategoria se construyen en el code-behind (posiciones + foco dinamicos).
             ============================================================ -->
        <Canvas x:Name="SidebarHost" Width="1920" Height="1080" IsVisible="False" ClipToBounds="True">
            <!-- Atenuado del contenido: DESACTIVADO a proposito (la captura de Xbox si lo
                 lleva, pero aqui se prefiere el contenido a pleno brillo con la barra abierta). Se deja el
                 elemento, sin usar, por si se quiere recuperar: bastaria con volver a fundirlo. -->
            <Rectangle x:Name="SidebarDim" Canvas.Left="192" Canvas.Top="0" Width="1728" Height="1080"
                       Fill="#99000000" IsHitTestVisible="False" IsVisible="False" />

            <!-- 2a COLUMNA (Col1Layer): va DEBAJO de las etiquetas en z-order para que, al abrir, PAREZCA
                 EMERGER desde detras de ellas (se desliza hacia la derecha mientras aparece). Visible solo
                 cuando la categoria enfocada tiene subcategorias. El deslizamiento/opacidad los anima el
                 code-behind (AnimateIn). -->
            <Canvas x:Name="Col1Layer">
                <Canvas x:Name="SubColumn">
                    <!-- FONDO ACRILICO: foto DESENFOCADA de lo que hay debajo (la hace el code-behind al
                         abrir). Va recortada a la columna; la imagen se coloca en -389 para que caiga
                         1:1 sobre el contenido real que tapa. Medido en "tienda barra lateral": detras
                         del panel no hay detalle, solo manchas suaves = desenfoque + tinte. -->
                    <Canvas Canvas.Left="384" Canvas.Top="0" Width="413" Height="1080" ClipToBounds="True">
                        <Image x:Name="BackdropCol1" Canvas.Left="-384" Canvas.Top="0" Width="1920" Height="1080" />
                    </Canvas>
                    <!-- col.SUBCATEGORIAS: TINTE translucido (384..797). Medido: mismo tono que las
                         etiquetas pero ~10 puntos mas claro. Empieza en 384 (justo donde acaba la
                         columna de etiquetas) para que no quede una rendija de contenido nitido entre
                         las dos. En la captura buena NO hay linea divisoria ni sombra: la separacion
                         entre columnas es solo el cambio de tono. -->
                    <Rectangle Canvas.Left="384" Canvas.Top="0" Width="413" Height="1080" Fill="#C72B3133" />
                </Canvas>
                <!-- Tiles de subcategoria (construidos en el code-behind). -->
                <Canvas x:Name="SidebarSubHost" />
            </Canvas>

            <!-- COLUMNA DE ETIQUETAS (Col0Layer): ENCIMA de la 2a columna. Se desliza/funde al abrir,
                 apareciendo a partir de los iconos del rail. -->
            <Canvas x:Name="Col0Layer">
                <!-- FONDO ACRILICO de esta columna (misma foto desenfocada, recortada a 192..384). -->
                <Canvas Canvas.Left="192" Canvas.Top="0" Width="192" Height="1080" ClipToBounds="True">
                    <Image x:Name="BackdropCol0" Canvas.Left="-192" Canvas.Top="0" Width="1920" Height="1080" />
                </Canvas>
                <!-- Extension del panel del rail (192..384): TINTE translucido medido (30,41,41) al ~70%. -->
                <Rectangle Canvas.Left="192" Canvas.Top="0" Width="192" Height="1080" Fill="#C71E2929" />
                <!-- Barra del ACTIVO (sigue el color del tema). El code-behind la coloca en la fila enfocada. -->
                <Rectangle x:Name="SidebarActiveBar" Canvas.Left="40" Canvas.Top="302" Width="4" Height="28"
                           RadiusX="2" RadiusY="2" Fill="{DynamicResource AccentBrush}" />
                <!-- Nombre del perfil (junto al avatar), visible solo al expandir. -->
                <!-- El texto lo pone el code-behind con el usuario de Windows (Environment.UserName).
                     Antes estaba pegado a mano el de la captura de referencia. -->
                <TextBlock x:Name="SidebarProfileName" Canvas.Left="140" Canvas.Top="49" Text=""
                           FontSize="24" FontWeight="SemiBold" Foreground="White" />
                <!-- Etiquetas (construidas en el code-behind). -->
                <Canvas x:Name="SidebarLabelHost" />
            </Canvas>
        </Canvas>

    </Canvas>
</UserControl>
