<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Playfront.App.Views.StoreView"
             Width="1920" Height="1080">
    <!-- STORE screen (1:1 with the Xbox Series X Store). Lives in its own view so it loads ON DEMAND
         (performance architecture: nothing is built before it is opened): MainWindow creates it on
         entry (EnterStore) and releases it on exit (ExitStore). Styles and theme resources
         (AccentBrush, selectionRing...) live on the window/app and CASCADE down here.

         Built in phases:
           PHASE 1: background (measured gradient).
           PHASE 2: narrow left rail (profile + icons + divider + account).
           Next: content (hero + cards + game row) and the double sidebar.

         The rail is line icons over the background. The icons are the REAL Xbox app SVGs
         (Microsoft.GamingApp) inlined as Path (same pattern as ButtonX/battery): Search, Store
         (bag = Home), HeartWishlist, Settings, ConsoleSolid (Hardware), GiftCard (Redeem). The 4 that
         this app version does not ship as a standalone file (controller, clapperboard, grid, cart)
         are drawn by hand, measured from the reference. The ACTIVE section (Home) gets the accent bar
         + white icon; the rest are grey. -->

    <UserControl.Styles>
        <!-- Real Xbox rail icon (filled path, viewBox 0 0 32 32). Grey by default. -->
        <Style Selector="Path.railGlyph">
            <Setter Property="Fill" Value="#B9BEC1" />
        </Style>
        <!-- Hand-drawn rail icon (stroked). -->
        <Style Selector="Path.railStroke">
            <Setter Property="Stroke" Value="#B9BEC1" />
            <Setter Property="StrokeThickness" Value="2" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeJoin" Value="Round" />
            <Setter Property="Fill" Value="Transparent" />
        </Style>

        <!-- Store content tile. Dark grey fill measured from the references (the empty UI tiles -
             SEARCH/DEALS - are ~#2F3437; the hero and image cards get their art later). Corner radius
             ~6 (measured). ClipToBounds so art and bands are clipped to the corners. -->
        <Style Selector="Border.storeTile">
            <Setter Property="Background" Value="#242A2D" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Action tile (SEARCH / REDEEM A CODE / DEALS): slightly lighter grey, as in the reference. -->
        <Style Selector="Border.storeAction">
            <Setter Property="Background" Value="#2E3336" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="ClipToBounds" Value="True" />
        </Style>
        <!-- Large title over an image tile (hero / cards). -->
        <Style Selector="TextBlock.storeTitle">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.storeSubtitle">
            <Setter Property="Foreground" Value="#E0E0E0" />
            <Setter Property="FontSize" Value="22" />
        </Style>
        <!-- Label of an action tile (next to its icon). -->
        <Style Selector="TextBlock.storeActionLabel">
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="26" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Section header ("Games"). -->
        <Style Selector="TextBlock.storeSection">
            <Setter Property="Foreground" Value="#D6D6D6" />
            <Setter Property="FontSize" Value="34" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

    </UserControl.Styles>

    <Canvas Width="1920" Height="1080" ClipToBounds="True">

        <!-- ===== BACKGROUND ===== -->
        <!-- ONE diagonal gradient (no radials, no layers), sampled EXACTLY from the Store home
             reference (excluding rail and tiles): dark teal top-left ~(6,37,32) -> dark neutral
             bottom-right ~(21,20,31), with blue rising slightly in the middle. The rail (0..192) is
             covered by its own grey panel, so only x>192 matters here. -->
        <!-- BASE = the HUE, horizontally: dark teal on the left (top-left measured (6,37,32)) ->
             neutral on the right (top-right (28,27,32)). Uniform vertically. -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Offset="0" Color="#082F26" />
                    <GradientStop Offset="1" Color="#1C1B20" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>
        <!-- 2nd gradient = the BRIGHTNESS, vertically: TRANSPARENT at the top (leaves the base hue
             untouched) -> dark at the bottom. Alpha-composited it darkens the lower half towards
             bottom-left (13,22,27) and bottom-right (21,20,31) without touching the top edge.
             Colour/alpha is the compromise that nails both bottom corners (a=50%). Two soft
             gradients = still no visible layer seams. -->
        <Rectangle Width="1920" Height="1080">
            <Rectangle.Fill>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                    <GradientStop Offset="0" Color="#00000000" />
                    <GradientStop Offset="1" Color="#80110A1A" />
                </LinearGradientBrush>
            </Rectangle.Fill>
        </Rectangle>

        <!-- ===== RAIL: TEAL PANEL + SEPARATOR ===== -->
        <!-- Measured on the Store home reference: the rail (x<240) is its own teal PANEL (rgb
             ~7-20,37,37), greener and slightly lighter than the purple content, and UNIFORM top to
             bottom (it does not follow the background's diagonal gradient). Here we paint the panel
             plus the thin vertical edge LINE; the SHADOW over the content next to the rail is painted
             last (topmost) so it falls ON the tiles, as in the reference. -->
        <!-- Rail: NEUTRAL strip slightly LIGHTER than the background (measured: rail ~36 brightness
             against the gap/content ~27). It ends at the divider LINE at x=192, NOT at 240: in the
             original the line sits ~46 px left of the tile edge with a gap in between - which is why
             it looked like "a wider column". Between the rail (0..192) and the tiles (240) there is a
             gap (192..240) that the SHADOW below darkens = "shadow to the right of the line".
             Kept neutral rather than teal because teal reads as green on the Ally's screen. -->
        <Rectangle x:Name="RailPanel" Canvas.Left="0" Canvas.Top="0" Width="192" Height="1080" Fill="#1D2627" />
        <!-- Thin vertical divider line at the rail's right edge, at x=192. -->
        <Rectangle x:Name="RailDivider" Canvas.Left="192" Canvas.Top="0" Width="1.5" Height="1080" Fill="#2CFFFFFF" />

        <!-- ===== NARROW RAIL (icon centre x=95) ===== -->

        <!-- Profile (circular avatar) at the top -->
        <Border Canvas.Left="70" Canvas.Top="38" Width="50" Height="50" CornerRadius="25" ClipToBounds="True">
            <Image Source="/Assets/Icons/avatar.png" Stretch="UniformToFill" />
        </Border>

        <!-- Accent bar of the ACTIVE section (Home). Vertical, left of the icon. -->
        <Rectangle x:Name="RailActiveBar" Canvas.Left="40" Canvas.Top="219" Width="4" Height="28" RadiusX="2" RadiusY="2"
                   Fill="{DynamicResource AccentBrush}" />

        <!-- Search (real SVG: Search.svg) -->
        <Viewbox Canvas.Left="80" Canvas.Top="135" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Classes="railGlyph" Data="M30 29C30 29.2708 29.901 29.5052 29.7031 29.7031C29.5052 29.901 29.2708 30 29 30C28.7292 30 28.4948 29.901 28.2969 29.7031L20.0312 21.4375C19.0521 22.2604 17.9583 22.8906 16.75 23.3281C15.5417 23.7656 14.2917 23.9896 13 24C11.9896 24 11.0156 23.8698 10.0781 23.6094C9.14062 23.349 8.26562 22.9792 7.45312 22.5C6.64062 22.0208 5.90104 21.4479 5.23438 20.7812C4.56771 20.1146 3.98958 19.3698 3.5 18.5469C3.01042 17.724 2.64062 16.849 2.39062 15.9219C2.14062 14.9948 2.01042 14.0208 2 13C2 11.9896 2.13021 11.0156 2.39062 10.0781C2.65104 9.14062 3.02083 8.26562 3.5 7.45312C3.97917 6.64062 4.55208 5.90104 5.21875 5.23438C5.88542 4.56771 6.63021 3.98958 7.45312 3.5C8.27604 3.01042 9.15104 2.64062 10.0781 2.39062C11.0052 2.14062 11.9792 2.01042 13 2C14.0104 2 14.9844 2.13021 15.9219 2.39062C16.8594 2.65104 17.7344 3.02083 18.5469 3.5C19.3594 3.97917 20.099 4.55208 20.7656 5.21875C21.4323 5.88542 22.0104 6.63021 22.5 7.45312C22.9896 8.27604 23.3594 9.15104 23.6094 10.0781C23.8594 11.0052 23.9896 11.9792 24 13C24 14.2812 23.7812 15.526 23.3438 16.7344C22.9062 17.9427 22.2708 19.0417 21.4375 20.0312L29.7031 28.2969C29.901 28.4948 30 28.7292 30 29ZM22 13C22 12.1771 21.8958 11.3854 21.6875 10.625C21.4792 9.86458 21.1771 9.14583 20.7812 8.46875C20.3854 7.79167 19.9115 7.18229 19.3594 6.64062C18.8073 6.09896 18.1979 5.63021 17.5312 5.23438C16.8646 4.83854 16.151 4.53646 15.3906 4.32812C14.6302 4.11979 13.8333 4.01042 13 4C11.7604 4 10.5938 4.23438 9.5 4.70312C8.40625 5.17188 7.45312 5.81771 6.64062 6.64062C5.82812 7.46354 5.1875 8.41667 4.71875 9.5C4.25 10.5833 4.01042 11.75 4 13C4 14.25 4.23438 15.4219 4.70312 16.5156C5.17188 17.6094 5.8125 18.5625 6.625 19.375C7.4375 20.1875 8.39062 20.8281 9.48438 21.2969C10.5781 21.7656 11.75 22 13 22C14.2396 22 15.4062 21.7656 16.5 21.2969C17.5938 20.8281 18.5469 20.1823 19.3594 19.3594C20.1719 18.5365 20.8125 17.5833 21.2812 16.5C21.75 15.4167 21.9896 14.25 22 13Z" />
            </Canvas>
        </Viewbox>

        <!-- Home (real SVG: Store.svg, the bag). ACTIVE: white. -->
        <Viewbox Canvas.Left="80" Canvas.Top="218" Width="30" Height="30">
            <Canvas Width="32" Height="32">
                <Path Fill="White" Data="M9.875,32 C9.09375,32 8.34895833,31.84375 7.640625,31.53125 C6.93229167,31.21875 6.30729167,30.7916667 5.765625,30.25 C5.22395833,29.7083333 4.796875,29.0833333 4.484375,28.375 C4.171875,27.6666667 4.01041667,26.9166667 4,26.125 L4,10 C4,9.44791667 4.19270833,8.97916667 4.578125,8.59375 C4.97395833,8.19791667 5.44791667,8 6,8 L8,8 L8,4.890625 C8,4.234375 8.13020833,3.609375 8.390625,3.015625 C8.65104167,2.421875 9.00520833,1.90625 9.453125,1.46875 C9.90104167,1.03125 10.421875,0.677083333 11.015625,0.40625 C11.609375,0.135416667 12.234375,0 12.890625,0 C13.453125,0 13.9947917,0.078125 14.515625,0.234375 C15.0364583,0.390625 15.53125,0.645833333 16,1 C16.4583333,0.645833333 16.9479167,0.390625 17.46875,0.234375 C17.9895833,0.078125 18.5364583,0 19.109375,0 C19.7760417,0 20.4010417,0.130208333 20.984375,0.390625 C21.5677083,0.651041667 22.0833333,1.00520833 22.53125,1.453125 C22.9791667,1.90104167 23.328125,2.421875 23.578125,3.015625 C23.828125,3.609375 23.96875,4.234375 24,4.890625 C24.0104167,5.06770833 24.015625,5.23958333 24.015625,5.40625 C24.015625,5.57291667 24.015625,5.74479167 24.015625,5.921875 L24.015625,6.96875 C24.015625,7.3125 24.0104167,7.65625 24,8 L26,8 C26.2708333,8 26.5260417,8.05208333 26.765625,8.15625 C27.0052083,8.26041667 27.21875,8.40625 27.40625,8.59375 C27.59375,8.78125 27.7395833,8.99479167 27.84375,9.234375 C27.9479167,9.47395833 28,9.72916667 28,10 L28,27.109375 C28,27.765625 27.8697917,28.390625 27.609375,28.984375 C27.3489583,29.578125 26.9947917,30.09375 26.546875,30.53125 C26.0989583,30.96875 25.578125,31.3229167 24.984375,31.59375 C24.390625,31.8645833 23.765625,32 23.109375,32 L9.875,32 Z M10,8 L16,8 L16,5 C16,4.59375 15.921875,4.20833333 15.765625,3.84375 C15.609375,3.47916667 15.3958333,3.16145833 15.125,2.890625 C14.8541667,2.61979167 14.53125,2.40104167 14.15625,2.234375 C13.78125,2.06770833 13.3958333,1.98958333 13,2 C12.59375,2 12.2083333,2.078125 11.84375,2.234375 C11.4791667,2.390625