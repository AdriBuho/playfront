            <!-- "Settings" section header -->
            <TextBlock Canvas.Left="527" Canvas.Top="540" Text="Settings" Foreground="White" FontSize="34" FontWeight="SemiBold" />

            <!-- Group 2: settings (some with an "On" state) -->
            <Border Classes="manageCard" Canvas.Left="525" Canvas.Top="627" Width="640" Height="108">
                <Grid VerticalAlignment="Center" Margin="44,0,30,0" ColumnDefinitions="Auto,*,Auto">
                    <TextBlock Grid.Column="0" Width="44" TextAlignment="Center" Text="&#xE895;" FontFamily="Segoe Fluent Icons" FontSize="34" Foreground="White" VerticalAlignment="Center" />
